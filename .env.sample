# ======================================
# MOSS MENU – MUHIT O‘ZGARUVCHILARI (ENVIRONMENT VARIABLES)
# ======================================

#  SERVER SOZLAMALARI
APP_PORT = 4000
# Izoh: Backend server ishlaydigan port. O‘zgartirish mumkin (masalan: 3000, 5000).



#  MONGODB ULANISH
MONGO_URL = mongodb://localhost:27017/mossmenu
# Izoh: MongoDB ulanish stringi.
# Format: mongodb://username:password@host:port/database_name
# Mahalliy: mongodb://127.0.0.1:27017/mossmenu
# Cloud (MongoDB Atlas): mongodb+srv://user:pass@cluster.mongodb.net/mossmenu



#  TOKEN SOZLAMALARI (JWT)
SECRET_KEY = your_super_secret_key_change_me
# Izoh: Access token uchun maxfiy kalit. Kamida 32 belgi, hech qachon gitga qo‘ymang.
# Yaratish: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

EXPIRE_TIME = 1d
# Izoh: Access token yashash muddati.
# Qabul qilinadigan format: 1d (bir kun), 2h (ikki soat), 30m (30 daqiqa), 7d, '30s'

REFRESH_TOKEN_SECRET_KEY = your_refresh_token_secret_key
# Izoh: Refresh token uchun maxfiy kalit. SECRET_KEY dan farqli bo‘lishi tavsiya etiladi.

REFRESH_TOKEN_EXPIRE_TIME = 30d
# Izoh: Refresh token amal qilish muddati. Odatda access token dan uzoq (30 kun, 60 kun).



#  GOOGLE APP PASSWORD (EMAIL XABARNOMA UCHUN)
GOOGLE_APP_PASSWORD = your_google_app_password
# Izoh: Gmail yoki Google Workspace uchun app paroli.
# Qanday olish: Google hisobingizga kiring -> Xavfsizlik -> 2 bosqichli tekshiruv -> Ilova parollari.
# Tur: "Mail" va qurilma: "Custom" ni tanlang.

GOOGLE_ACCOUNT_USER = example@gmail.com
# Izoh: Xat yuborishda ishlatiladigan Google hisobining emaili.



#  SIGNATURE & URL
SIGN_URL_SECRET = your_sign_secret
# Izoh: URL imzolash (signature) uchun maxfiy kalit. Masalan, tasdiqlash havolalarida.

BASE_URL = http://localhost:4000
# Izoh: Saytning to‘liq asosiy URL manzili. Prodakshn: https://mossmenu.com



#  COOKIE SOZLAMALARI
COOKIE_SECRET_KEY = cookie_secret_key_for_signed_cookies
# Izoh: Cookie autentifikatsiyasi uchun maxfiy kalit. 32+ belgi.



#  CLOUDINARY (RASM YUKLASH UCHUN)
CLOUDINARY_CLOUD_NAME = your_cloudinary_cloud_name
# Izoh: Cloudinary dashboard -> Settings -> Account -> Cloud name

CLOUDINARY_API_KEY = your_cloudinary_api_key
# Izoh: Cloudinary dashboard -> Settings -> API Keys

CLOUDINARY_API_SECRET = your_cloudinary_api_secret
# Izoh: Cloudinary dashboard -> Settings -> API Keys (maxfiy, hech qachon gitga qo'ymang)



#  ADMINISTRATOR DEFAULT LOGIN
ADMIN_EMAIL = admin@mossmenu.com
# Izoh: Dastlabki admin foydalanuvchi emaili. Tizim birinchi ishga tushganda yaratiladi.

ADMIN_PASS = Admin123!
# Izoh: Admin paroli. Iloji boricha murakkabroq qilib o‘zgartiring.