<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} | MossMenu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <style>
        /* ===== Barcha stillar (sizning home page dagi stillarni to‘liq qo‘ying) ===== */
        /* Qisqartirish uchun bu yerga o‘z stillaringizni qo‘ying, lekin navbar, user-menu va error uchun kerakli stillar bo‘lishi kerak */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --primary: #c8622a;
            --primary-dark: #a34d1e;
            --primary-light: #e8845a;
            --accent: #f5a623;
            --accent-light: #fde8c0;
            --bg: #f7f3ef;
            --surface: #ffffff;
            --text: #1a1410;
            --text-muted: #7a6a5a;
            --border: #e2d8cc;
            --radius: 16px;
        }
        body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); display: flex; flex-direction: column; min-height: 100vh; }
        /* navbar stillari (home page dan olingan) */
        nav {
            position: sticky; top: 0; z-index: 100;
            background: rgba(247,243,239,.92);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            padding: 0 48px; height: 64px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .nav-logo { display: flex; align-items: center; text-decoration: none; }
        .nav-links { display: flex; align-items: center; gap: 36px; list-style: none; }
        .nav-links a {
            font-size: 14px; font-weight: 500; color: var(--text-muted);
            text-decoration: none; transition: color .2s;
        }
        .nav-links a:hover { color: var(--text); }
        .nav-links a.active { color: var(--text); }
        .btn-owner {
            padding: 10px 22px; background: var(--primary); color: #fff;
            border: none; border-radius: 12px;
            font-weight: 600; text-decoration: none;
        }
        .user-menu { position: relative; }
        .user-btn {
            display: flex; align-items: center; gap: 10px;
            background: var(--surface); border: 1.5px solid var(--border);
            padding: 5px 14px 5px 5px; border-radius: 30px;
            cursor: pointer;
        }
        .user-avatar {
            width: 30px; height: 30px; border-radius: 50%;
            background: var(--primary); color: white;
            display: grid; place-items: center; font-size: 13px; font-weight: 700;
        }
        .user-name { font-size: 14px; font-weight: 600; }
        .user-dropdown {
            position: absolute; top: calc(100% + 8px); right: 0;
            min-width: 220px; background: var(--surface);
            border: 1px solid var(--border); border-radius: 14px;
            padding: 6px; opacity: 0; pointer-events: none;
            transform: translateY(-8px);
            transition: opacity .2s, transform .2s;
        }
        .user-dropdown.show { opacity: 1; pointer-events: auto; transform: translateY(0); }
        .user-info { padding: 12px 14px; border-bottom: 1px solid var(--border); }
        .user-info-name { font-size: 14px; font-weight: 700; }
        .badge-admin {
            background: var(--primary); color: white; padding: 2px 8px; border-radius: 999px; font-size: 10px;
        }
        .user-link {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 12px; border-radius: 8px;
            text-decoration: none; color: var(--text);
        }
        .user-link:hover { background: var(--bg2); }
        .user-link-danger { color: #b91c1c; }
        .user-divider { height: 1px; background: var(--border); margin: 6px 0; }

        /* error content */
        .error-container { flex: 1; display: flex; align-items: center; justify-content: center; padding: 60px 20px; }
        .error-card { max-width: 550px; background: var(--surface); border-radius: var(--radius); border: 1px solid var(--border); padding: 48px 36px; text-align: center; }
        .error-code { font-size: 100px; font-weight: 800; font-family: 'Playfair Display', serif; color: var(--primary-light); line-height: 1; }
        .error-title { font-size: 24px; font-weight: 700; margin: 16px 0; }
        .error-message { color: var(--text-muted); margin-bottom: 20px; }
        .error-url { background: var(--bg); border-radius: 12px; padding: 10px; font-size: 14px; word-break: break-all; margin-bottom: 28px; }
        .btn-home { display: inline-flex; align-items: center; gap: 8px; background: var(--primary); color: white; padding: 12px 28px; border-radius: 12px; text-decoration: none; font-weight: 600; }
        footer { background: #1a1410; color: rgba(255,255,255,.5); text-align: center; padding: 24px; margin-top: auto; }
        @media (max-width: 640px) { nav { padding: 0 20px; } .error-card { padding: 32px 24px; } .error-code { font-size: 70px; } }
    </style>
</head>
<body>

    <!-- ========== NAVBAR (HOME/MENU PAGE DAGI KOD) ========== -->
    <nav>
        <a href="/" class="nav-logo">
            <svg width="140" height="36" viewBox="0 0 160 40">
                <rect x="0" y="0" width="160" height="40" rx="20" fill="#c8622a"/>
                <circle cx="22" cy="20" r="15" fill="white" fill-opacity="0.15"/>
                <g transform="translate(13, 9)">
                    <line x1="5"  y1="1" x2="5"  y2="19" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                    <line x1="3"  y1="1" x2="3"  y2="7"  stroke="white" stroke-width="1.2" stroke-linecap="round"/>
                    <line x1="5"  y1="1" x2="5"  y2="7"  stroke="white" stroke-width="1.2" stroke-linecap="round"/>
                    <line x1="7"  y1="1" x2="7"  y2="7"  stroke="white" stroke-width="1.2" stroke-linecap="round"/>
                    <path d="M3 7 Q5 9.5 7 7" fill="none" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
                    <line x1="12" y1="1" x2="12" y2="19" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M12 1 Q17 4 17 8 Q17 13 12 13" fill="white"/>
                </g>
                <text x="43" y="26" font-family="Georgia, serif" font-size="16" font-weight="700" fill="white" font-style="italic">MossMenu</text>
            </svg>
        </a>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/menu">Menu</a></li>
            <li><a href="/feedback">Feedback</a></li>
        </ul>

        {{#if user}}
            <div class="user-menu">
                <button class="user-btn" id="userBtn">
                    <span class="user-avatar">{{user.initial}}</span>
                    <span class="user-name">{{user.name}}</span>
                    <i data-lucide="chevron-down" width="14" height="14"></i>
                </button>
                <div class="user-dropdown" id="userDropdown">
                    <div class="user-info">
                        <div class="user-info-name">{{user.name}}</div>
                        <div class="user-info-role">
                            {{#if user.isAdmin}}
                                <span class="badge-admin">ADMIN</span>
                            {{else}}
                                Foydalanuvchi
                            {{/if}}
                        </div>
                    </div>
                    {{#if user.isAdmin}}
                        <a href="/admin" class="user-link">
                            <i data-lucide="layout-dashboard" width="14" height="14"></i> Dashboard
                        </a>
                    {{/if}}
                    <a href="/feedback" class="user-link">
                        <i data-lucide="message-circle" width="14" height="14"></i> Fikr qoldirish
                    </a>
                    <div class="user-divider"></div>
                    <a href="/logout" class="user-link user-link-danger">
                        <i data-lucide="log-out" width="14" height="14"></i> Chiqish
                    </a>
                </div>
            </div>
        {{else}}
            <a href="/login" class="btn-owner">Login</a>
        {{/if}}
    </nav>

    <!-- 404 CONTENT -->
    <div class="error-container">
        <div class="error-card">
            <div class="error-code">404</div>
            <h1 class="error-title">Sahifa topilmadi</h1>
            <p class="error-message">Siz izlayotgan sahifa mavjud emas yoki ko‘chirilgan.</p>
            <div class="error-url">{{url}}</div>
            <a href="/" class="btn-home">
                <i data-lucide="home" width="18" height="18"></i> Bosh sahifaga qaytish
            </a>
        </div>
    </div>

    <footer>
        <p>&copy; {{year}} MossMenu. Barcha huquqlar himoyalangan.</p>
    </footer>

    <script>
        lucide.createIcons();
        // User dropdown
        (function () {
            var btn = document.getElementById("userBtn");
            var dropdown = document.getElementById("userDropdown");
            if (btn && dropdown) {
                btn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    dropdown.classList.toggle("show");
                });
                document.addEventListener("click", function (e) {
                    if (!dropdown.contains(e.target) && !btn.contains(e.target)) {
                        dropdown.classList.remove("show");
                    }
                });
            }
        })();
    </script>
</body>
</html>