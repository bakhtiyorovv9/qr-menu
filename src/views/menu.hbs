<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body { width: 100%; min-height: 100vh; scroll-behavior: smooth; }

        body {
            font-family: 'DM Sans', sans-serif;
            color: #1a1410;
            background: #f7f3ef;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            display: flex;
            flex-direction: column;
        }

        :root {
            --primary:       #c8622a;
            --primary-dark:  #a34d1e;
            --primary-light: #e8845a;
            --accent:        #f5a623;
            --accent-light:  #fde8c0;
            --bg:            #f7f3ef;
            --bg2:           #f0e9e1;
            --surface:       #ffffff;
            --text:          #1a1410;
            --text-muted:    #7a6a5a;
            --border:        #e2d8cc;
            --radius:        16px;
            --radius-lg:     24px;
            --shadow-sm:     0 1px 2px rgba(26,20,16,.05);
            --shadow-lg:     0 12px 32px rgba(26,20,16,.10);
        }

        /* ===== NAVBAR — home page stilida ===== */
        nav {
            position: sticky; top: 0; z-index: 100;
            background: rgba(247,243,239,0.92);
            backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            padding: 0 48px; height: 64px;
            display: flex; align-items: center; justify-content: space-between;
            animation: slideDown .4s ease both;
        }
        @keyframes slideDown {
            from { transform: translateY(-100%); opacity: 0; }
            to   { transform: translateY(0);     opacity: 1; }
        }

        .nav-logo {
            display: flex; align-items: center; gap: 10px; text-decoration: none;
        }
        .nav-logo .logo-mark {
            width: 36px; height: 36px;
            background: var(--primary); border-radius: 10px;
            display: flex; align-items: center; justify-content: center; font-size: 18px;
        }
        .nav-logo span {
            font-family: 'Playfair Display', serif;
            font-size: 20px; font-weight: 700; color: var(--text);
        }

        .nav-links { display: flex; align-items: center; gap: 36px; list-style: none; }
        .nav-links a {
            font-size: 14px; font-weight: 500; color: var(--text-muted);
            text-decoration: none; transition: color .2s; position: relative;
        }
        .nav-links a::after {
            content: ''; position: absolute; bottom: -3px; left: 0;
            width: 0; height: 2px;
            background: var(--primary); border-radius: 2px; transition: width .25s;
        }
        .nav-links a:hover { color: var(--text); }
        .nav-links a:hover::after { width: 100%; }
        .nav-links a.active { color: var(--text); }
        .nav-links a.active::after { width: 100%; }

        .btn-owner {
            padding: 10px 22px; background: var(--primary); color: #fff;
            border: none; border-radius: 12px;
            font-family: "DM Sans", sans-serif; font-size: 14px; font-weight: 600;
            text-decoration: none; cursor: pointer;
            transition: background .2s, transform .15s, box-shadow .2s;
            box-shadow: 0 4px 14px rgba(200,98,42,.28);
        }
        .btn-owner:hover { background: var(--primary-dark); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(200,98,42,.38); }

        /* ===== HERO ===== */
        .hero {
            width: 100%;
            background: linear-gradient(120deg, var(--bg2) 0%, var(--accent-light) 30%, #f5d4a0 50%, var(--accent-light) 70%, var(--bg2) 100%);
            background-size: 200% 100%;
            animation: shimmerMove 12s linear infinite;
            padding: 64px 48px 52px; position: relative; overflow: hidden;
        }
        @keyframes shimmerMove {
            0%   { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        .hero::before {
            content: ""; position: absolute; top: -100px; right: -100px;
            width: 340px; height: 340px;
            background: radial-gradient(circle, rgba(200,98,42,.15), transparent 70%);
            border-radius: 50%; pointer-events: none;
        }
        .hero-wrap {
            max-width: 1280px; margin: 0 auto;
            display: flex; align-items: flex-end; justify-content: space-between;
            gap: 40px; position: relative;
        }
        .hero-left { flex: 1; }
        .eyebrow {
            display: inline-flex; align-items: center; gap: 8px;
            color: var(--primary-dark); font-size: 13px; font-weight: 700;
            letter-spacing: .12em; text-transform: uppercase; margin-bottom: 18px;
        }
        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(36px, 4.5vw, 56px); font-weight: 700;
            letter-spacing: -.03em; line-height: 1.06;
            color: var(--text); margin-bottom: 18px;
        }
        .hero h1 em { font-style: italic; color: var(--primary); }
        .hero-desc { color: var(--text-muted); font-size: 15px; line-height: 1.65; max-width: 480px; }
        .hero-right { flex-shrink: 0; padding-bottom: 8px; }
        .search-box {
            display: flex; align-items: center; gap: 10px;
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 12px; padding: 14px 18px;
            width: 300px; box-shadow: var(--shadow-sm); transition: all .2s;
        }
        .search-box:focus-within {
            border-color: var(--primary); box-shadow: 0 0 0 4px rgba(200,98,42,.12);
        }
        .search-box input {
            border: none; outline: none; width: 100%;
            font-family: inherit; font-size: 14px; color: var(--text); background: transparent;
        }
        .search-box input::placeholder { color: var(--text-muted); }
        .search-box svg { color: var(--text-muted); flex-shrink: 0; }

        /* ===== FILTERS ===== */
        .filters-section {
            width: 100%; padding: 22px 48px;
            background: var(--surface); border-bottom: 1px solid var(--border);
        }
        .filters-wrap {
            max-width: 1280px; margin: 0 auto;
            display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
        }
        .filter-label {
            display: inline-flex; align-items: center; gap: 8px;
            color: var(--text); font-weight: 600; font-size: 14px; margin-right: 6px;
        }
        .chip {
            border: 1px solid var(--border); background: var(--surface);
            color: var(--text-muted); padding: 9px 20px; border-radius: 999px;
            font-family: inherit; font-size: 14px; font-weight: 500;
            cursor: pointer; transition: all .2s; text-decoration: none; white-space: nowrap;
        }
        .chip:hover { border-color: var(--primary); color: var(--primary-dark); }
        .chip.active { background: var(--primary); border-color: var(--primary); color: white; font-weight: 600; }

        /* ===== MENU GRID ===== */
        .menu-section { width: 100%; flex: 1; padding: 48px 48px 72px; }
        .menu-grid {
            max-width: 1280px; margin: 0 auto;
            display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
        }

        /* ===== CARD ===== */
        .card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius); overflow: hidden;
            display: flex; flex-direction: column;
            opacity: 0; transform: translateY(20px);
        }
        .card.visible {
            opacity: 1; transform: translateY(0);
            transition: opacity .5s ease, transform .5s ease, box-shadow .3s, border-color .3s;
        }
        .card.visible:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--accent-light); }

        .card-img-wrap {
            position: relative; aspect-ratio: 4/3; overflow: hidden; background: var(--bg2);
        }
        .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
        .card.visible:hover .card-img-wrap img { transform: scale(1.06); }

        .price-badge {
            position: absolute; top: 12px; right: 12px;
            background: var(--primary); color: white;
            padding: 5px 11px; border-radius: 999px;
            font-size: 12px; font-weight: 700;
            box-shadow: 0 4px 10px rgba(200,98,42,.35);
        }
        .rating-badge {
            position: absolute; bottom: 12px; left: 12px;
            background: rgba(255,255,255,.95); backdrop-filter: blur(4px);
            padding: 4px 10px; border-radius: 999px;
            font-size: 12px; font-weight: 600; color: var(--text);
            display: inline-flex; align-items: center; gap: 4px;
        }
        .rating-badge svg { color: var(--accent); fill: var(--accent); }

        .card-body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex: 1; }
        .card-category {
            font-size: 11px; font-weight: 700; letter-spacing: .1em;
            color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px;
        }
        .card-title {
            font-family: 'Playfair Display', serif;
            font-size: 17px; font-weight: 700; color: var(--text);
            line-height: 1.3; margin-bottom: 8px;
        }
        .card-desc {
            color: var(--text-muted); font-size: 13px; line-height: 1.55; flex: 1;
            margin-bottom: 16px;
            display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
        }
        .card-btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 7px;
            border: 1px solid var(--primary-light); background: transparent;
            color: var(--primary-dark); padding: 10px; border-radius: 10px;
            font-family: inherit; font-size: 13px; font-weight: 600;
            cursor: pointer; transition: all .2s; text-decoration: none;
        }
        .card-btn:hover { background: var(--accent-light); border-color: var(--primary); }

        /* ===== EMPTY STATE ===== */
        .empty-state {
            max-width: 1280px; margin: 0 auto;
            padding: 80px 20px; text-align: center; color: var(--text-muted);
        }
        .empty-state svg { width: 56px; height: 56px; color: var(--border); margin-bottom: 16px; }
        .empty-state h3 { font-family: 'Playfair Display', serif; font-size: 22px; color: var(--text-muted); margin-bottom: 8px; }

        /* ===== FOOTER ===== */
        footer {
            width: 100%;
            background: #1a1410; color: rgba(255,255,255,.85);
            padding: 52px 48px 24px; margin-top: auto;
        }
        .footer-grid {
            display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr;
            gap: 48px; margin-bottom: 40px;
        }
        .footer-brand .logo-wrap { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
        .footer-brand .logo-mark-footer {
            width: 34px; height: 34px; background: var(--primary); border-radius: 10px;
            display: flex; align-items: center; justify-content: center; font-size: 16px;
        }
        .footer-brand .brand-name {
            font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: white;
        }
        .footer-brand p { font-size: 13px; color: rgba(255,255,255,.5); line-height: 1.7; margin-bottom: 20px; }
        .social-links { display: flex; gap: 10px; }
        .social-link {
            width: 34px; height: 34px; border-radius: 10px;
            background: rgba(255,255,255,.08);
            display: flex; align-items: center; justify-content: center;
            color: rgba(255,255,255,.6); text-decoration: none; font-size: 14px;
            transition: background .2s, color .2s;
        }
        .social-link:hover { background: var(--primary); color: white; }
        .footer-col h4 {
            font-size: 13px; font-weight: 700; letter-spacing: .06em;
            text-transform: uppercase; color: rgba(255,255,255,.4); margin-bottom: 16px;
        }
        .footer-col ul { list-style: none; }
        .footer-col ul li { margin-bottom: 10px; }
        .footer-col ul li a { font-size: 14px; color: rgba(255,255,255,.65); text-decoration: none; transition: color .15s; }
        .footer-col ul li a:hover { color: white; }
        .footer-col ul li span { font-size: 14px; color: rgba(255,255,255,.65); }
        .footer-bottom {
            padding-top: 24px;
            border-top: 1px solid rgba(255,255,255,.1);
            text-align: center;
        }
        .footer-bottom p { font-size: 13px; color: rgba(255,255,255,.35); }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 1024px) {
            .menu-grid { grid-template-columns: repeat(3, 1fr); }
            .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
        }
        @media (max-width: 800px) {
            .hero-wrap { flex-direction: column; }
            .search-box { width: 100%; max-width: 420px; }
        }
        @media (max-width: 720px) { .menu-grid { grid-template-columns: repeat(2, 1fr); } }

        /* ===== MOBILE BURGER ===== */
        .burger {
            display: none;
            background: none; border: none; cursor: pointer;
            width: 40px; height: 40px; padding: 0;
            position: relative;
            z-index: 110;
        }
        .burger span {
            display: block;
            width: 22px; height: 2px;
            background: var(--text);
            margin: 5px auto;
            border-radius: 2px;
            transition: transform .3s, opacity .3s;
        }
        .burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        .burger.open span:nth-child(2) { opacity: 0; }
        .burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

        .mobile-menu {
            position: fixed; top: 0; right: -100%;
            width: 80%; max-width: 320px; height: 100vh;
            background: var(--surface);
            box-shadow: -8px 0 32px rgba(26,20,16,.12);
            transition: right .3s ease;
            z-index: 105; padding: 88px 24px 24px;
            display: flex; flex-direction: column;
            overflow-y: auto;
        }
        .mobile-menu.open { right: 0; }
        .mobile-menu a {
            display: flex; align-items: center; gap: 12px;
            padding: 14px 16px; border-radius: 12px;
            font-size: 16px; font-weight: 500;
            color: var(--text); text-decoration: none;
            transition: background .15s;
            margin-bottom: 4px;
        }
        .mobile-menu a:hover, .mobile-menu a.active {
            background: var(--accent-light); color: var(--primary-dark);
        }
        .mobile-menu a.active { font-weight: 700; }
        .mobile-menu .m-divider { height: 1px; background: var(--border); margin: 16px 0; }
        .mobile-menu .m-user-info {
            padding: 16px;
            background: var(--bg);
            border-radius: 12px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .mobile-menu .m-avatar {
            width: 40px; height: 40px; border-radius: 50%;
            background: var(--primary); color: white;
            display: grid; place-items: center;
            font-size: 16px; font-weight: 700;
            flex-shrink: 0;
        }
        .mobile-menu .m-user-name { font-size: 14px; font-weight: 700; color: var(--text); }
        .mobile-menu .m-user-role { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
        .mobile-menu .m-login-btn {
            display: block; text-align: center;
            background: var(--primary); color: white;
            padding: 14px; border-radius: 12px;
            font-size: 15px; font-weight: 600;
            margin-top: 8px;
        }
        .mobile-menu .m-login-btn:hover { background: var(--primary-dark); color: white; }
        .mobile-menu .m-danger { color: #b91c1c; }
        .mobile-menu .m-danger:hover { background: #fef2f2; color: #b91c1c; }
        .menu-overlay {
            position: fixed; inset: 0;
            background: rgba(0,0,0,.4);
            opacity: 0; pointer-events: none;
            transition: opacity .3s;
            z-index: 102;
        }
        .menu-overlay.show { opacity: 1; pointer-events: auto; }

        /* iPhone 13 Pro / 14 Pro (390px) and below */
        @media (max-width: 768px) {
            nav { padding: 0 20px; height: 60px; }
            .nav-links { display: none; }
            .user-menu { display: none; }
            nav > a.btn-owner { display: none; }
            .burger { display: block; }

            .nav-logo svg { width: 120px; height: 30px; }

            .hero { padding: 40px 20px 32px; }
            .hero h1 { font-size: 32px; }
            .hero-desc { font-size: 14px; }

            .filters-section { padding: 16px 20px; }
            .filter-chip { font-size: 12px; padding: 6px 14px; }

            .menu-section { padding: 28px 20px 48px; }
            .menu-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }

            .menu-card { padding: 0; }
            .menu-card-img { height: 140px; }
            .menu-card-body { padding: 12px; }
            .menu-card-name { font-size: 14px; }
            .price-badge { font-size: 12px; padding: 4px 8px; }

            footer { padding: 36px 20px 20px; }
            .footer-grid { grid-template-columns: 1fr; gap: 28px; }
        }

        /* iPhone XS / X (375px) */
        @media (max-width: 400px) {
            nav { padding: 0 16px; }
            .hero { padding: 32px 16px 28px; }
            .hero h1 { font-size: 28px; }
            .filters-section { padding: 14px 16px; }
            .menu-section { padding: 24px 16px 40px; }
            .menu-card-img { height: 120px; }
            .menu-card-name { font-size: 13px; }
        }

        /* iPhone SE (320px) */
        @media (max-width: 360px) {
            .hero h1 { font-size: 24px; }
            .menu-grid { grid-template-columns: 1fr; gap: 14px; }
            .menu-card-img { height: 180px; }
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }
                /* USER MENU */
        .user-menu { position: relative; }
        .user-btn {
            display: flex; align-items: center; gap: 10px;
            background: var(--surface); border: 1.5px solid var(--border);
            padding: 5px 14px 5px 5px; border-radius: 30px;
            cursor: pointer; font-family: inherit; transition: all .2s;
        }
        .user-btn:hover { border-color: var(--primary); background: var(--accent-light); }
        .user-avatar {
            width: 30px; height: 30px; border-radius: 50%;
            background: var(--primary); color: white;
            display: grid; place-items: center; font-size: 13px; font-weight: 700;
        }
        .user-name { font-size: 14px; font-weight: 600; color: var(--text); }
        .user-btn svg { color: var(--text-muted); }
        .user-dropdown {
            position: absolute; top: calc(100% + 8px); right: 0;
            min-width: 220px; background: var(--surface);
            border: 1px solid var(--border); border-radius: 14px;
            box-shadow: 0 10px 40px rgba(26,20,16,.12);
            padding: 6px; opacity: 0; pointer-events: none;
            transform: translateY(-8px);
            transition: opacity .2s, transform .2s; z-index: 200;
        }
        .user-dropdown.show { opacity: 1; pointer-events: auto; transform: translateY(0); }
        .user-info { padding: 12px 14px; border-bottom: 1px solid var(--border); margin-bottom: 6px; }
        .user-info-name { font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
        .user-info-role { font-size: 12px; color: var(--text-muted); }
        .badge-admin {
            display: inline-block; padding: 2px 8px; border-radius: 999px;
            background: var(--primary); color: white;
            font-size: 10px; font-weight: 700; letter-spacing: .05em;
        }
        .user-link {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 12px; border-radius: 8px;
            color: var(--text); text-decoration: none;
            font-size: 14px; font-weight: 500; transition: background .15s;
        }
        .user-link:hover { background: var(--bg2); }
        .user-link svg { color: var(--text-muted); }
        .user-link-danger { color: #b91c1c; }
        .user-link-danger:hover { background: #fef2f2; }
        .user-link-danger svg { color: #b91c1c; }
        .user-divider { height: 1px; background: var(--border); margin: 6px 0; }
    </style>
</head>
<body>

    <!-- ========== NAVBAR (home page stilida) ========== -->
        <!-- ========== NAVBAR (home page stilida, USER MENU BILAN) ========== -->
    <nav>
        <a href="/" class="nav-logo">
            <svg width="140" height="36" viewBox="0 0 160 40">
                <rect x="0" y="0" width="160" height="40" rx="20" fill="#c8622a"/>
                <circle cx="22" cy="20" r="15" fill="white" fill-opacity="0.15"/>
                <g transform="translate(13, 9)">
                    <line x1="5"  y1="1" x2="5"  y2="19" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                    <line x1="3"  y1="1" x2="3"  y2="7"  stroke="white" stroke-width="1.2" stroke-linecap="round"/>
                    <line x1="5"  y1="1" x2="5"  y2="7"  stroke="white" stroke-width="1.2" stroke-linecap="round"/>
                    <line x1="7"  y1="1" x2="7"  y2="7"  stroke="white" stroke-width="1.2" stroke-linecap="round"/>
                    <path d="M3 7 Q5 9.5 7 7" fill="none" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
                    <line x1="12" y1="1" x2="12" y2="19" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M12 1 Q17 4 17 8 Q17 13 12 13" fill="white"/>
                </g>
                <text x="43" y="26" font-family="Georgia, serif" font-size="16" font-weight="700" fill="white" font-style="italic">MossMenu</text>
            </svg>
        </a>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/menu" class="active">Menu</a></li>
            <li><a href="/feedback">Feedback</a></li>
        </ul>

        {{#if user}}
            <div class="user-menu">
                <button class="user-btn" id="userBtn">
                    <span class="user-avatar">{{user.initial}}</span>
                    <span class="user-name">{{user.name}}</span>
                    <i data-lucide="chevron-down" width="14" height="14"></i>
                </button>
                <div class="user-dropdown" id="userDropdown">
                    <div class="user-info">
                        <div class="user-info-name">{{user.name}}</div>
                        <div class="user-info-role">
                            {{#if user.isAdmin}}
                                <span class="badge-admin">ADMIN</span>
                            {{else}}
                                Foydalanuvchi
                            {{/if}}
                        </div>
                    </div>
                    {{#if user.isAdmin}}
                        <a href="/admin" class="user-link">
                            <i data-lucide="layout-dashboard" width="14" height="14"></i>
                            Dashboard
                        </a>
                    {{/if}}
                    <a href="/feedback" class="user-link">
                        <i data-lucide="message-circle" width="14" height="14"></i>
                        Fikr qoldirish
                    </a>
