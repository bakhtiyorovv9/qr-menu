<div class="auth-wrapper">
    <!-- LEFT PANEL -->
    <div class="auth-panel">
        <div class="panel-logo">
            <svg width="140" height="36" viewBox="0 0 160 40">
    <rect x="0" y="0" width="160" height="40" rx="20" fill="#c8622a"/>
    <circle cx="22" cy="20" r="15" fill="white" fill-opacity="0.15"/>
    <g transform="translate(13, 9)">
        <line x1="5"  y1="1" x2="5"  y2="19" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
        <line x1="3"  y1="1" x2="3"  y2="7"  stroke="white" stroke-width="1.2" stroke-linecap="round"/>
        <line x1="5"  y1="1" x2="5"  y2="7"  stroke="white" stroke-width="1.2" stroke-linecap="round"/>
        <line x1="7"  y1="1" x2="7"  y2="7"  stroke="white" stroke-width="1.2" stroke-linecap="round"/>
        <path d="M3 7 Q5 9.5 7 7" fill="none" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
        <line x1="12" y1="1" x2="12" y2="19" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M12 1 Q17 4 17 8 Q17 13 12 13" fill="white"/>
    </g>
    <text x="43" y="26" font-family="Georgia, serif" font-size="16" font-weight="700" fill="white" font-style="italic">MossMenu</text>
</svg>
        </div>
        <div class="panel-content">
            <div class="panel-badge">
                <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                Siz ham ovoz bering
            </div>
            <h2 class="panel-title">Restoran tajribasini birgalikda yaxshilaymiz</h2>
            <p class="panel-desc">
                Hisob oching va sevimli restoranlaringiz menyu sifati, xizmat darajasi haqida fikr bildiring. Takliflaringiz hisobga olinadi.
            </p>
            <div class="panel-divider"></div>
            <div class="panel-security">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                Barcha ma'lumotlaringiz xavfsiz himoyalangan.
            </div>
        </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="auth-form-side">
        <!-- Tabs -->
        <div class="auth-tabs">
            <a href="/login" class="auth-tab">Kirish</a>
            <a href="/register" class="auth-tab active">Yangi hisob</a>
        </div>

        <h1 class="form-title">Hisob yaratish</h1>
        <p class="form-subtitle">Bir necha soniyada ro'yxatdan o'ting va boshlang.</p>

        {{#if error}}
        <div class="alert alert-error">⚠️ {{error}}</div>
        {{/if}}

        {{#if success}}
        <div class="alert alert-success">✓ {{success}}</div>
        {{/if}}

        <form action="/api/auth/register" method="POST">
            <!-- Name -->
            <div class="form-group">
                <label for="name">To'liq ism</label>
                <div class="input-wrap" style="margin-top:7px">
                    <span class="input-icon">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </span>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Ismingiz va familiyangiz"
                        value="{{oldName}}"
                        required
                        minlength="1"
                        autocomplete="name"
                    />
                </div>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label for="email">Elektron pochta</label>
                <div class="input-wrap" style="margin-top:7px">
                    <span class="input-icon">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </span>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="example@mossmenu.com"
                        value="{{oldEmail}}"
                        required
                        autocomplete="email"
                    />
                </div>
            </div>

            <!-- Password -->
            <div class="form-group">
                <label for="password">Parol</label>
                <div class="input-wrap" style="margin-top:7px">
                    <span class="input-icon">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                    </span>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Kamida 6 ta belgi"
                        required
                        minlength="6"
                        autocomplete="new-password"
                    />
                    <button type="button" class="toggle-pw" aria-label="Parolni ko'rsatish">
                        <svg class="eye-open" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        <svg class="eye-closed" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display:none">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                        </svg>
                    </button>
                </div>
                <p style="font-size:12px;color:#b5a898;margin-top:6px;">Parol kamida 6 ta belgidan iborat bo'lishi kerak</p>
            </div>

            <button type="submit" class="btn-primary" style="margin-top:4px">Ro'yxatdan o'tish</button>
        </form>

        <div class="divider"><span>Yoki shuning bilan davom eting</span></div>

        <div class="social-btns">
            <a href="/auth/google" class="btn-social">
                <svg width="18" height="18" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                Google
            </a>
            <a href="/auth/github" class="btn-social">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                GitHub
            </a>
        </div>

        <a href="/" class="back-link">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Bosh sahifaga qaytish
        </a>
    </div>
</div>
