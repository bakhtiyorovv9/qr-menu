                </svg>
            </a>
        </div>

        {{#if categories.length}}
            <div class="cat-grid">
                {{#each categories}}
                    <a href="/menu?category={{this._id}}" class="cat-card">
                        {{#if this.image}}
                            <img src="{{this.image}}" alt="{{this.name}}" class="cat-img" loading="lazy" />
                        {{else}}
