                        <div class="stars">★★★★★</div>
                        <p class="review-text">"{{this.message}}"</p>
                        <div class="reviewer">
                            <div class="reviewer-avatar">{{this.userInitial}}</div>
                            <div>
                                <div class="reviewer-name">{{this.userName}}</div>
