<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --primary: #c8622a;
            --primary-dark: #a34d1e;
            --primary-light: #e8845a;
            --accent: #f5a623;
            --accent-light: #fde8c0;
            --bg: #f7f3ef;
            --bg2: #f0e9e1;
            --surface: #ffffff;
            --text: #1a1410;
            --text-muted: #7a6a5a;
            --border: #e2d8cc;
            --radius: 16px;
            --radius-lg: 24px;
        }

        html { scroll-behavior: smooth; }
        body { font-family: "DM Sans", sans-serif; background: var(--bg); color: var(--text); overflow-x: hidden; }

        /* NAVBAR */
        nav {
            position: sticky; top: 0; z-index: 100;
            background: rgba(247,243,239,.92);
            backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            padding: 0 48px; height: 64px;
            display: flex; align-items: center; justify-content: space-between;
            animation: slideDown .4s ease both;
        }
        @keyframes slideDown { from { transform: translateY(-100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

        .nav-logo { display: flex; align-items: center; text-decoration: none; line-height: 0; }

        .nav-links { display: flex; align-items: center; gap: 36px; list-style: none; }
        .nav-links a {
            font-size: 14px; font-weight: 500; color: var(--text-muted);
            text-decoration: none; transition: color .2s; position: relative;
        }
        .nav-links a::after {
            content: ""; position: absolute; bottom: -3px; left: 0;
            width: 0; height: 2px; background: var(--primary); border-radius: 2px;
            transition: width .25s;
        }
        .nav-links a:hover { color: var(--text); }
        .nav-links a:hover::after { width: 100%; }
        .nav-links a.active { color: var(--text); }
        .nav-links a.active::after { width: 100%; }

        .btn-owner {
            padding: 10px 22px; background: var(--primary); color: #fff;
            border: none; border-radius: 12px;
            font-family: "DM Sans", sans-serif; font-size: 14px; font-weight: 600;
            text-decoration: none; cursor: pointer;
            transition: background .2s, transform .15s, box-shadow .2s;
            box-shadow: 0 4px 14px rgba(200,98,42,.28);
        }
        .btn-owner:hover { background: var(--primary-dark); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(200,98,42,.38); }

        /* USER MENU */
        .user-menu { position: relative; }
        .user-btn {
            display: flex; align-items: center; gap: 10px;
            background: var(--surface); border: 1.5px solid var(--border);
            padding: 5px 14px 5px 5px; border-radius: 30px;
            cursor: pointer; font-family: inherit; transition: all .2s;
        }
        .user-btn:hover { border-color: var(--primary); background: var(--accent-light); }
        .user-avatar {
            width: 30px; height: 30px; border-radius: 50%;
            background: var(--primary); color: white;
            display: grid; place-items: center; font-size: 13px; font-weight: 700;
        }
        .user-name { font-size: 14px; font-weight: 600; color: var(--text); }
        .user-btn svg { color: var(--text-muted); }
        .user-dropdown {
            position: absolute; top: calc(100% + 8px); right: 0;
            min-width: 220px; background: var(--surface);
            border: 1px solid var(--border); border-radius: 14px;
            box-shadow: 0 10px 40px rgba(26,20,16,.12);
            padding: 6px; opacity: 0; pointer-events: none;
            transform: translateY(-8px);
            transition: opacity .2s, transform .2s; z-index: 200;
        }
        .user-dropdown.show { opacity: 1; pointer-events: auto; transform: translateY(0); }
        .user-info { padding: 12px 14px; border-bottom: 1px solid var(--border); margin-bottom: 6px; }
        .user-info-name { font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
        .user-info-role { font-size: 12px; color: var(--text-muted); }
        .badge-admin {
            display: inline-block; padding: 2px 8px; border-radius: 999px;
            background: var(--primary); color: white;
            font-size: 10px; font-weight: 700; letter-spacing: .05em;
        }
        .user-link {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 12px; border-radius: 8px;
            color: var(--text); text-decoration: none;
            font-size: 14px; font-weight: 500; transition: background .15s;
        }
        .user-link:hover { background: var(--bg2); }
        .user-link svg { color: var(--text-muted); }
        .user-link-danger { color: #b91c1c; }
        .user-link-danger:hover { background: #fef2f2; }
        .user-link-danger svg { color: #b91c1c; }
        .user-divider { height: 1px; background: var(--border); margin: 6px 0; }

        /* HERO */
        .hero {
            padding: 80px 80px 70px;
            display: grid; grid-template-columns: 1fr 420px;
            gap: 60px; align-items: center;
            background: var(--bg); position: relative; overflow: hidden;
        }
        .hero::before {
            content: ""; position: absolute; top: -80px; right: -80px;
            width: 500px; height: 500px;
            background: radial-gradient(circle, rgba(200,98,42,.08) 0%, transparent 70%);
            pointer-events: none;
        }
        .hero-badge {
            display: inline-flex; align-items: center; gap: 8px;
            background: var(--accent-light); border: 1px solid rgba(245,166,35,.35);
            color: var(--primary-dark); font-size: 13px; font-weight: 600;
            padding: 7px 16px; border-radius: 20px; margin-bottom: 24px;
            width: fit-content; animation: fadeUp .5s .1s ease both;
        }
        .hero-badge::before {
            content: ""; width: 7px; height: 7px; border-radius: 50%;
            background: var(--primary); animation: pulse 2s infinite;
        }
        @keyframes pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .5; transform: scale(.8); } }
        .hero h1 {
            font-family: "Playfair Display", serif;
            font-size: clamp(40px, 5vw, 60px); font-weight: 700; line-height: 1.12;
            color: var(--text); margin-bottom: 20px;
            animation: fadeUp .5s .2s ease both;
        }
        .hero h1 em { font-style: italic; color: var(--primary); }
        .hero-desc {
            font-size: 16px; color: var(--text-muted); line-height: 1.7;
            max-width: 480px; margin-bottom: 36px;
            animation: fadeUp .5s .3s ease both;
        }
        .hero-actions { display: flex; gap: 14px; align-items: center; animation: fadeUp .5s .4s ease both; }

        .btn-primary-lg {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 14px 28px; background: var(--primary); color: #fff;
            border: none; border-radius: 14px;
            font-family: "DM Sans", sans-serif; font-size: 15px; font-weight: 600;
            text-decoration: none; cursor: pointer;
            transition: background .2s, transform .15s, box-shadow .2s;
            box-shadow: 0 4px 18px rgba(200,98,42,.32);
        }
        .btn-primary-lg:hover { background: var(--primary-dark); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(200,98,42,.4); }
        .btn-primary-lg svg { transition: transform .2s; }
        .btn-primary-lg:hover svg { transform: translateX(4px); }

        .btn-ghost {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 14px 24px; background: transparent; color: var(--text);
            border: 1.5px solid var(--border); border-radius: 14px;
            font-family: "DM Sans", sans-serif; font-size: 15px; font-weight: 500;
            text-decoration: none; cursor: pointer;
            transition: border-color .2s, background .2s;
        }
        .btn-ghost:hover { border-color: var(--primary-light); background: rgba(200,98,42,.05); }

        /* QR Card */
        .qr-card {
            background: var(--surface); border-radius: var(--radius-lg);
            padding: 48px; display: flex; flex-direction: column;
            align-items: center; gap: 20px;
            box-shadow: 0 16px 50px rgba(100,50,20,.1);
            animation: fadeUp .5s .25s ease both;
            position: relative; border: 1px solid var(--border);
        }
        .qr-card::before {
            content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        }
        .qr-svg { width: 130px; height: 130px; padding: 10px; background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
        .qr-card h3 { font-family: "Playfair Display", serif; font-size: 18px; font-weight: 700; color: var(--text); }
        .qr-card p { font-size: 13px; color: var(--text-muted); text-align: center; line-height: 1.5; }

        @keyframes fadeUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }

        /* SECTIONS */
        section { padding: 80px 80px; }
        .section-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 36px; }
        .section-title { font-family: "Playfair Display", serif; font-size: 32px; font-weight: 700; }
        .section-sub { font-size: 14px; color: var(--text-muted); margin-top: 6px; }
        .link-all {
            font-size: 14px; font-weight: 600; color: var(--primary);
            text-decoration: none; display: flex; align-items: center; gap: 4px;
            transition: gap .2s;
        }
        .link-all:hover { gap: 8px; }

        /* CATEGORIES */
        .categories { background: var(--surface); }
        .cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
        .cat-card {
            border-radius: var(--radius); overflow: hidden;
            background: var(--bg); border: 1px solid var(--border);
            text-decoration: none; color: var(--text);
            transition: transform .25s, box-shadow .25s;
            opacity: 0; transform: translateY(20px);
        }
        .cat-card.visible {
            opacity: 1; transform: translateY(0);
            transition: opacity .5s ease, transform .5s ease, box-shadow .25s;
        }
        .cat-card.visible:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(100,50,20,.12); }
        .cat-img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; }
        .cat-img-placeholder {
            width: 100%; aspect-ratio: 4/3;
            background: linear-gradient(135deg, #e8ddd4, #d4c4b4);
            display: flex; align-items: center; justify-content: center; font-size: 36px;
        }
        .cat-footer { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; }
        .cat-label { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
        .cat-icon {
            width: 26px; height: 26px; border-radius: 8px;
            background: var(--accent-light);
            display: flex; align-items: center; justify-content: center; font-size: 13px;
        }
        .cat-arrow {
            width: 28px; height: 28px; border-radius: 50%;
            border: 1.5px solid var(--border);
            display: flex; align-items: center; justify-content: center;
            color: var(--text-muted);
            transition: background .2s, border-color .2s, color .2s;
        }
        .cat-card.visible:hover .cat-arrow { background: var(--primary); border-color: var(--primary); color: white; }

        /* FEATURED DISHES */
        .featured { background: var(--bg); }
        .featured-header { text-align: center; margin-bottom: 12px; }
        .featured-header .section-title { font-size: 36px; }
        .featured-sub {
            text-align: center; font-size: 15px; color: var(--text-muted);
            line-height: 1.6; max-width: 500px; margin: 0 auto 48px;
        }
        .underline-accent { display: inline-block; position: relative; }
        .underline-accent::after {
            content: ""; position: absolute; bottom: -4px; left: 0; right: 0;
            height: 3px; background: linear-gradient(90deg, var(--primary), var(--accent));
            border-radius: 2px;
        }
        .dishes-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
        .dish-card {
            background: var(--surface); border-radius: var(--radius-lg);
            overflow: hidden; border: 1px solid var(--border);
            opacity: 0; transform: translateY(20px);
        }
        .dish-card.visible {
            opacity: 1; transform: translateY(0);
            transition: opacity .5s ease, transform .5s ease, box-shadow .25s;
        }
        .dish-card.visible:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(100,50,20,.13); }
        .dish-img-wrap { position: relative; overflow: hidden; aspect-ratio: 16/10; }
        .dish-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
        .dish-card.visible:hover .dish-img { transform: scale(1.06); }
        .dish-img-placeholder {
            width: 100%; aspect-ratio: 16/10;
            background: linear-gradient(135deg, var(--bg2), var(--border));
            display: flex; align-items: center; justify-content: center; font-size: 48px;
        }
        .dish-badge {
            position: absolute; top: 14px; left: 14px;
            padding: 5px 12px; border-radius: 20px;
            font-size: 11px; font-weight: 700; letter-spacing: .04em;
            text-transform: uppercase; background: var(--primary); color: white;
        }
        .dish-price-badge {
            position: absolute; top: 14px; right: 14px;
            background: rgba(255,255,255,.95); backdrop-filter: blur(4px);
            padding: 5px 12px; border-radius: 20px;
            font-size: 13px; font-weight: 700; color: var(--primary);
        }
        .dish-body { padding: 20px; }
        .dish-name-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
        .dish-name { font-family: "Playfair Display", serif; font-size: 17px; font-weight: 700; line-height: 1.3; }
        .dish-cat-label {
            font-size: 11px; font-weight: 700; letter-spacing: .08em;
            text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;
        }
        .dish-desc {
            font-size: 13px; color: var(--text-muted); line-height: 1.6;
            margin-bottom: 18px; display: -webkit-box;
            -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
        }
        .btn-detail {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 10px 20px; border: 1.5px solid var(--border);
            border-radius: 10px; font-size: 13px; font-weight: 600;
            color: var(--text); text-decoration: none; background: var(--bg);
            transition: border-color .2s, background .2s, color .2s, gap .2s;
            width: 100%; justify-content: center;
        }
        .btn-detail:hover { border-color: var(--primary); background: rgba(200,98,42,.06); color: var(--primary); gap: 10px; }

        /* EMPTY STATES */
        .empty-cats, .empty-dishes {
            text-align: center; padding: 48px 20px; color: var(--text-muted);
            border: 1.5px dashed var(--border); border-radius: var(--radius-lg);
        }
        .empty-cats svg, .empty-dishes svg { width: 48px; height: 48px; color: var(--border); margin-bottom: 12px; }
        .empty-cats h3, .empty-dishes h3 { font-size: 18px; color: var(--text-muted); margin-bottom: 6px; }
        .empty-cats p, .empty-dishes p { font-size: 14px; }

        /* REVIEWS */
        .reviews-section {
            background: var(--surface); display: grid;
            grid-template-columns: 1fr 1.1fr; gap: 80px; align-items: center;
        }
        .reviews-left h2 { font-family: "Playfair Display", serif; font-size: 36px; font-weight: 700; line-height: 1.2; margin-bottom: 18px; }
        .reviews-left p { font-size: 15px; color: var(--text-muted); line-height: 1.7; margin-bottom: 32px; }
        .btn-feedback {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 13px 26px; background: var(--accent-light);
            color: var(--primary-dark); border: 1.5px solid rgba(245,166,35,.4);
            border-radius: 14px; font-family: "DM Sans", sans-serif;
            font-size: 14px; font-weight: 600; text-decoration: none;
            transition: background .2s, transform .15s, box-shadow .2s;
        }
        .btn-feedback:hover { background: var(--accent); color: var(--text); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(245,166,35,.3); }
        .reviews-right { display: flex; flex-direction: column; gap: 16px; }
        .review-card {
            background: var(--bg); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 22px;
            opacity: 0; transform: translateY(16px);
        }
        .review-card.visible {
            opacity: 1; transform: translateY(0);
            transition: opacity .5s ease, transform .5s ease, box-shadow .2s;
        }
        .review-card.visible:hover { transform: translateX(6px); box-shadow: 0 8px 28px rgba(100,50,20,.09); }
        .stars { color: var(--accent); font-size: 14px; letter-spacing: 2px; margin-bottom: 10px; }
        .review-text { font-size: 14px; color: var(--text); line-height: 1.65; margin-bottom: 14px; font-style: italic; }
        .reviewer { display: flex; align-items: center; gap: 10px; }
        .reviewer-avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 700; color: white; flex-shrink: 0;
        }
        .reviewer-name { font-size: 13px; font-weight: 600; }
        .reviewer-role { font-size: 11px; color: var(--text-muted); }

        /* CTA */
        .cta-section {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 50%, var(--primary-light) 100%);
            padding: 80px; text-align: center; position: relative; overflow: hidden;
        }
        .cta-section::before { content: ""; position: absolute; top: -60px; left: -60px; width: 300px; height: 300px; border-radius: 50%; background: rgba(255,255,255,.06); pointer-events: none; }
        .cta-section::after { content: ""; position: absolute; bottom: -80px; right: -40px; width: 400px; height: 400px; border-radius: 50%; background: rgba(255,255,255,.04); pointer-events: none; }
        .cta-section h2 { font-family: "Playfair Display", serif; font-size: 38px; font-weight: 700; color: white; margin-bottom: 14px; position: relative; z-index: 1; }
        .cta-section p { font-size: 16px; color: rgba(255,255,255,.8); margin-bottom: 36px; position: relative; z-index: 1; }
        .btn-cta {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 15px 36px; background: white; color: var(--primary-dark);
            border: none; border-radius: 14px;
            font-family: "DM Sans", sans-serif; font-size: 16px; font-weight: 700;
            text-decoration: none; cursor: pointer;
            transition: transform .2s, box-shadow .2s;
            box-shadow: 0 8px 30px rgba(0,0,0,.2); position: relative; z-index: 1;
        }
        .btn-cta:hover { transform: translateY(-3px); box-shadow: 0 14px 40px rgba(0,0,0,.28); }

        /* FOOTER */
        footer { background: #1a1410; color: rgba(255,255,255,.85); padding: 60px 80px 32px; }
        .footer-grid {
            display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr;
            gap: 48px; padding-bottom: 48px;
            border-bottom: 1px solid rgba(255,255,255,.1); margin-bottom: 28px;
        }
        .footer-brand .logo-wrap { line-height: 0; margin-bottom: 16px; }
        .footer-brand p { font-size: 13px; color: rgba(255,255,255,.5); line-height: 1.7; margin-bottom: 22px; }
        .social-links { display: flex; gap: 10px; }
        .social-link {
            width: 34px; height: 34px; border-radius: 10px;
            background: rgba(255,255,255,.08);
            display: flex; align-items: center; justify-content: center;
            color: rgba(255,255,255,.6); text-decoration: none; font-size: 14px;
            transition: background .2s, color .2s;
        }
        .social-link:hover { background: var(--primary); color: white; }
        .footer-col h4 {
            font-size: 13px; font-weight: 700; letter-spacing: .06em;
            text-transform: uppercase; color: rgba(255,255,255,.4); margin-bottom: 18px;
        }
        .footer-col ul { list-style: none; }
        .footer-col ul li { margin-bottom: 10px; }
        .footer-col ul li a { font-size: 14px; color: rgba(255,255,255,.65); text-decoration: none; transition: color .15s; }
        .footer-col ul li a:hover { color: white; }
        .footer-col ul li span { font-size: 14px; color: rgba(255,255,255,.65); }
        .footer-bottom { display: flex; align-items: center; justify-content: center; }
        .footer-bottom p { font-size: 13px; color: rgba(255,255,255,.35); }

        /* RESPONSIVE */
        @media (max-width: 900px) {
            nav { padding: 0 24px; }
            .hero { padding: 48px 24px; grid-template-columns: 1fr; }
            .qr-card { max-width: 320px; margin: 0 auto; }
            section { padding: 60px 24px; }
            .reviews-section { grid-template-columns: 1fr; gap: 40px; }
            .cat-grid { grid-template-columns: repeat(2, 1fr); }
            .dishes-grid { grid-template-columns: 1fr 1fr; }
            .cta-section { padding: 60px 24px; }
            .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
            footer { padding: 48px 24px 24px; }
        }

        /* ===== MOBILE BURGER ===== */
        .burger {
            display: none;
            background: none; border: none; cursor: pointer;
            width: 40px; height: 40px; padding: 0;
            position: relative;
            z-index: 110;
        }
        .burger span {
            display: block;
            width: 22px; height: 2px;
            background: var(--text);
            margin: 5px auto;
            border-radius: 2px;
            transition: transform .3s, opacity .3s;
        }
        .burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        .burger.open span:nth-child(2) { opacity: 0; }
        .burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

        .mobile-menu {
            position: fixed; top: 0; right: -100%;
            width: 80%; max-width: 320px; height: 100vh;
            background: var(--surface);
            box-shadow: -8px 0 32px rgba(26,20,16,.12);
            transition: right .3s ease;
            z-index: 105; padding: 88px 24px 24px;
            display: flex; flex-direction: column;
            overflow-y: auto;
        }
        .mobile-menu.open { right: 0; }
        .mobile-menu a {
            display: flex; align-items: center; gap: 12px;
            padding: 14px 16px; border-radius: 12px;
            font-size: 16px; font-weight: 500;
            color: var(--text); text-decoration: none;
            transition: background .15s;
            margin-bottom: 4px;
        }
        .mobile-menu a:hover, .mobile-menu a.active {
            background: var(--accent-light); color: var(--primary-dark);
        }
        .mobile-menu a.active { font-weight: 700; }
        .mobile-menu .m-divider { height: 1px; background: var(--border); margin: 16px 0; }
        .mobile-menu .m-user-info {
            padding: 16px;
            background: var(--bg);
            border-radius: 12px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .mobile-menu .m-avatar {
            width: 40px; height: 40px; border-radius: 50%;
            background: var(--primary); color: white;
            display: grid; place-items: center;
            font-size: 16px; font-weight: 700;
            flex-shrink: 0;
        }
        .mobile-menu .m-user-name { font-size: 14px; font-weight: 700; color: var(--text); }
        .mobile-menu .m-user-role { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
        .mobile-menu .m-login-btn {
            display: block; text-align: center;
            background: var(--primary); color: white;
            padding: 14px; border-radius: 12px;
            font-size: 15px; font-weight: 600;
            margin-top: 8px;
        }
        .mobile-menu .m-login-btn:hover { background: var(--primary-dark); color: white; }
        .mobile-menu .m-danger { color: #b91c1c; }
        .mobile-menu .m-danger:hover { background: #fef2f2; color: #b91c1c; }
        .menu-overlay {
            position: fixed; inset: 0;
            background: rgba(0,0,0,.4);
            opacity: 0; pointer-events: none;
            transition: opacity .3s;
            z-index: 102;
        }
        .menu-overlay.show { opacity: 1; pointer-events: auto; }

        /* iPhone 13 Pro / 14 Pro (390px) and below */
        @media (max-width: 768px) {
            nav { padding: 0 20px; height: 60px; }
            .nav-links { display: none; }
            .user-menu { display: none; }
            nav > a.btn-owner { display: none; }
            .burger { display: block; }

            .nav-logo svg { width: 120px; height: 30px; }

            .hero { padding: 40px 20px; gap: 24px; }
            .hero h1 { font-size: 36px; line-height: 1.1; }
            .hero-desc { font-size: 14px; }
            .hero-badge { font-size: 12px; padding: 6px 14px; }
            .hero-buttons { flex-direction: column; gap: 12px; }
            .hero-buttons .btn-primary, .hero-buttons .btn-secondary { width: 100%; }

            section { padding: 48px 20px; }
            .section-title { font-size: 28px; }
            .section-sub { font-size: 14px; }

            .cat-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
            .cat-card { padding: 18px 12px; }
            .cat-name { font-size: 14px; }

            .dishes-grid { grid-template-columns: 1fr; gap: 16px; }

            .reviews-section { padding: 48px 20px; gap: 32px; }

            .cta-section { padding: 48px 20px; }
            .cta-title { font-size: 26px; }

            footer { padding: 36px 20px 20px; }
            .footer-grid { grid-template-columns: 1fr; gap: 28px; }
        }

        /* iPhone XS / X (375px) */
        @media (max-width: 400px) {
            nav { padding: 0 16px; }
            .hero { padding: 32px 16px; }
            .hero h1 { font-size: 30px; }
            section { padding: 40px 16px; }
            .section-title { font-size: 24px; }
            .qr-card { max-width: 280px; padding: 24px; }
            .cta-title { font-size: 22px; }
        }

        /* iPhone SE (320px) */
        @media (max-width: 360px) {
            .hero h1 { font-size: 26px; }
            .cat-grid { grid-template-columns: 1fr; }
            .section-title { font-size: 22px; }
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
