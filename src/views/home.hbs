                            <i data-lucide="layout-dashboard" width="14" height="14"></i>
                            Dashboard
                        </a>
                    {{/if}}
                    <a href="/feedback" class="user-link">
                        <i data-lucide="message-circle" width="14" height="14"></i>
                        Fikr qoldirish
                    </a>
                    <div class="user-divider"></div>
                    <a href="/logout" class="user-link user-link-danger">
                        <i data-lucide="log-out" width="14" height="14"></i>
