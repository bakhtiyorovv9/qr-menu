<div class="page-header">
    <div>
        <h1 class="page-title">Shikoyatlar va sharhlar</h1>
        <p class="page-subtitle">Foydalanuvchilardan kelgan barcha fikrlar ({{totalCount}} ta)</p>
    </div>
</div>

{{#if flash.success}}
    <div class="flash flash-success">
        <i data-lucide="check-circle" width="18" height="18"></i>
        {{flash.success}}
    </div>
{{/if}}
{{#if flash.error}}
    <div class="flash flash-error">
        <i data-lucide="alert-circle" width="18" height="18"></i>
        {{flash.error}}
    </div>
{{/if}}

<!-- Filter tabs -->
<div class="tabs">
    <a href="/admin/feedbacks" class="tab {{#unless activeType}}active{{/unless}}">
        Hammasi <span class="tab-count">{{totalCount}}</span>
    </a>
    <a href="/admin/feedbacks?type=review" class="tab {{#if (eq activeType 'review')}}active{{/if}}">
        Sharhlar <span class="tab-count">{{reviewCount}}</span>
    </a>
    <a href="/admin/feedbacks?type=complaint" class="tab {{#if (eq activeType 'complaint')}}active{{/if}}">
        Shikoyatlar <span class="tab-count">{{complaintCount}}</span>
    </a>
</div>

{{#if feedbacks.length}}
    <div class="feedback-grid">
        {{#each feedbacks}}
            <div class="feedback-card {{this.type}}">
                <div class="fb-header">
                    <div class="fb-user">
                        <div class="fb-avatar">{{#if this.created_at.name}}{{firstChar this.created_at.name}}{{else}}?{{/if}}</div>
                        <div>
                            <div class="fb-name">{{#if this.created_at.name}}{{this.created_at.name}}{{else}}Anonim{{/if}}</div>
                            <div class="fb-email">{{this.created_at.email}}</div>
                        </div>
                    </div>
                    <span class="fb-type {{this.type}}">
                        {{#if (eq this.type 'review')}}
                            <i data-lucide="smile" width="13" height="13"></i> Sharh
                        {{else}}
                            <i data-lucide="frown" width="13" height="13"></i> Shikoyat
                        {{/if}}
                    </span>
                </div>

                {{#if this.rating}}
                    <div class="fb-stars">
                        {{#repeat this.rating}}<span class="star filled">★</span>{{/repeat}}
                    </div>
                {{/if}}

                <p class="fb-message">{{this.message}}</p>

                {{#if this.image}}
                    <div class="fb-image">
                        <img src="/uploads/{{this.image}}" alt="feedback image" loading="lazy" />
                    </div>
                {{/if}}

                <div class="fb-footer">
                    <div class="fb-meta">
                        <i data-lucide="calendar" width="13" height="13"></i>
                        {{this.createdAtFormatted}}
                        {{#if this.device_info}}
                            <span class="fb-device">
                                <i data-lucide="monitor" width="13" height="13"></i>
                                {{this.device_info}}
                            </span>
                        {{/if}}
                    </div>
                    <form action="/admin/feedbacks/{{this._id}}/delete" method="POST" style="display:inline">
                        <button type="submit" class="btn-delete-sm" onclick="return confirm('Feedbackni o\u0027chirishni tasdiqlaysizmi?')" title="O'chirish">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"></path>
                                <path d="M10 11v6"></path>
                                <path d="M14 11v6"></path>
                                <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </button>
                    </form>
                </div>
            </div>
        {{/each}}
    </div>
{{else}}
    <div class="empty-state">
        <i data-lucide="message-square" width="56" height="56"></i>
        <h3>Hali feedbacklar yo'q</h3>
        <p>Foydalanuvchilar fikr qoldirganda shu yerda ko'rinadi</p>
    </div>
{{/if}}

<style>
    .page-header {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 24px; gap: 16px; flex-wrap: wrap;
    }
    .page-title { font-size: 28px; font-weight: 800; color: #1a1410; margin-bottom: 4px; }
    .page-subtitle { color: #7a6a5a; font-size: 14px; }

    .flash {
        padding: 12px 16px; border-radius: 10px; margin-bottom: 16px;
        font-size: 14px; display: flex; align-items: center; gap: 10px;
    }
    .flash-success { background: #fff7ed; color: #a34d1e; border: 1px solid #fde8c0; }
    .flash-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }

    .tabs {
        display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap;
        border-bottom: 1px solid #e2d8cc; padding-bottom: 0;
    }
    .tab {
        padding: 10px 18px; border: none; background: transparent;
        color: #7a6a5a; font-size: 14px; font-weight: 500;
        text-decoration: none; border-bottom: 2px solid transparent;
        margin-bottom: -1px; transition: all .2s;
        display: inline-flex; align-items: center; gap: 8px;
    }
    .tab:hover { color: #1a1410; }
    .tab.active {
        color: #c8622a; border-bottom-color: #c8622a; font-weight: 600;
    }
    .tab-count {
        background: #f0e9e1; color: #7a6a5a;
        padding: 2px 8px; border-radius: 999px;
        font-size: 11px; font-weight: 700;
    }
    .tab.active .tab-count { background: #fde8c0; color: #c8622a; }

    .feedback-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 18px;
    }

    .feedback-card {
        background: white; border: 1px solid #e2d8cc;
        border-radius: 14px; padding: 18px;
        display: flex; flex-direction: column; gap: 12px;
        transition: all .25s;
    }
    .feedback-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(26,20,16,.08);
    }
    .feedback-card.complaint { border-left: 3px solid #b91c1c; }
    .feedback-card.review { border-left: 3px solid #16a34a; }

    .fb-header {
        display: flex; align-items: flex-start; justify-content: space-between;
        gap: 10px;
    }
    .fb-user { display: flex; gap: 10px; align-items: center; }
    .fb-avatar {
        width: 38px; height: 38px; border-radius: 50%;
        background: linear-gradient(135deg, #c8622a, #f5a623);
        color: white; display: grid; place-items: center;
        font-size: 14px; font-weight: 700; flex-shrink: 0;
    }
    .fb-name { font-size: 14px; font-weight: 700; color: #1a1410; }
    .fb-email { font-size: 12px; color: #7a6a5a; }

    .fb-type {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 4px 10px; border-radius: 999px;
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .04em;
        white-space: nowrap; flex-shrink: 0;
    }
    .fb-type.review { background: #dcfce7; color: #16a34a; }
    .fb-type.complaint { background: #fee2e2; color: #b91c1c; }

    .fb-stars { display: flex; gap: 2px; }
    .fb-stars .star { color: #d9d9d9; font-size: 16px; }
    .fb-stars .star.filled { color: #f5a623; }

    .fb-message {
        font-size: 14px; color: #1a1410; line-height: 1.55;
        background: #f7f3ef; padding: 12px 14px;
        border-radius: 10px;
    }

    .fb-image img {
        width: 100%; max-height: 200px; object-fit: cover;
        border-radius: 10px; border: 1px solid #e2d8cc;
    }

    .fb-footer {
        display: flex; align-items: center; justify-content: space-between;
        gap: 8px; padding-top: 10px; border-top: 1px solid #f0e9e1;
        flex-wrap: wrap;
    }
    .fb-meta {
        display: flex; align-items: center; gap: 8px;
        font-size: 12px; color: #7a6a5a; flex-wrap: wrap;
    }
    .fb-meta svg { color: #b4b2a9; }
    .fb-device {
        display: inline-flex; align-items: center; gap: 4px;
        padding-left: 8px; border-left: 1px solid #e2d8cc;
    }

    .btn-delete-sm {
        padding: 7px 9px; background: transparent;
        border: 1px solid #e2d8cc; color: #b91c1c;
        border-radius: 8px; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
        transition: all .2s; font-family: inherit;
    }
    .btn-delete-sm:hover { background: #fef2f2; border-color: #b91c1c; }

    .empty-state {
        background: white; border: 2px dashed #e2d8cc;
        border-radius: 14px; padding: 60px 24px;
        text-align: center; color: #7a6a5a;
    }
    .empty-state svg { color: #e2d8cc; margin-bottom: 16px; }
    .empty-state h3 { font-size: 18px; color: #1a1410; margin-bottom: 6px; }
</style>