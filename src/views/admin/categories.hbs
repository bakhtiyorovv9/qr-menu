{{!-- src/views/admin/categories.hbs --}}
<div class="page-header">
    <div>
        <h1 class="page-title">Kategoriyalar</h1>
        <p class="page-sub">Barcha kategoriyalar ro'yxati ({{categories.length}} ta)</p>
    </div>
    <a href="/admin/categories/create" class="btn-create">
        <i data-lucide="plus" width="18" height="18"></i>
        Yangi kategoriya
    </a>
</div>

{{#if flash.success}}
    <div class="flash-success">
        <i data-lucide="check-circle" width="16" height="16"></i>
        {{flash.success}}
    </div>
{{/if}}
{{#if flash.error}}
    <div class="flash-error">
        <i data-lucide="alert-circle" width="16" height="16"></i>
        {{flash.error}}
    </div>
{{/if}}

{{#if categories.length}}
    <div class="cat-grid">
        {{#each categories}}
            <div class="cat-card">
                <!-- Rasm -->
                <div class="cat-img-wrap">
                    {{#if this.image}}
                        <img src="{{this.image}}" alt="{{this.name}}" />
                    {{else}}
                        <div class="cat-img-placeholder">
                            <i data-lucide="layers" width="32" height="32"></i>
                        </div>
                    {{/if}}
                    <span class="cat-count-badge">
                        {{this.productCount}} ta taom
                    </span>
                </div>

                <!-- Info -->
                <div class="cat-body">
                    <div class="cat-name">{{this.name}}</div>
                    <div class="cat-meta">
                        <span class="cat-icon-badge">{{#if this.icon}}{{this.icon}}{{else}}🍴{{/if}}</span>
                        <span class="cat-date">{{this.createdAtFormatted}}</span>
                    </div>
                </div>

                <!-- Actions -->
                <div class="cat-actions">
                    <a href="/admin/categories/{{this._id}}/edit" class="btn-edit">
                        <i data-lucide="pencil" width="14" height="14"></i>
                        Edit
                    </a>
                    <button class="btn-delete"
                            onclick="confirmDelete('{{this._id}}', '{{this.name}}')">
                        <i data-lucide="trash-2" width="14" height="14"></i>
                        Delete
                    </button>
                </div>
            </div>
        {{/each}}
    </div>
{{else}}
    <div class="empty-state">
        <i data-lucide="layers"></i>
        <h3>Kategoriyalar yo'q</h3>
        <p>Hali hech qanday kategoriya qo'shilmagan.</p>
        <a href="/admin/categories/create" class="btn-create" style="display:inline-flex; margin-top:16px;">
            <i data-lucide="plus" width="16" height="16"></i>
            Birinchi kategoriya qo'shish
        </a>
    </div>
{{/if}}

<!-- Delete modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal">
        <div class="modal-icon">
            <i data-lucide="trash-2" width="28" height="28"></i>
        </div>
        <h3 class="modal-title">O'chirishni tasdiqlang</h3>
        <p class="modal-desc">
            "<strong id="deleteName"></strong>" kategoriyasini o'chirmoqchimisiz?
            Bu amalni qaytarib bo'lmaydi.
        </p>
        <div class="modal-actions">
            <button class="btn-modal-cancel" onclick="closeModal()">Bekor qilish</button>
            <form id="deleteForm" method="POST">
                <input type="hidden" name="_method" value="DELETE" />
                <button type="submit" class="btn-modal-delete">
                    <i data-lucide="trash-2" width="14" height="14"></i>
                    Ha, o'chirish
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .page-header {
        display: flex; align-items: flex-start; justify-content: space-between;
        margin-bottom: 28px; gap: 16px;
    }
    .page-title { font-size: 26px; font-weight: 700; color: var(--text); letter-spacing: -.02em; }
    .page-sub { font-size: 14px; color: var(--text-muted); margin-top: 4px; }

    .btn-create {
        display: inline-flex; align-items: center; gap: 8px;
        background: var(--primary); color: white;
        padding: 11px 20px; border-radius: 12px; border: none;
        font-family: inherit; font-size: 14px; font-weight: 600;
        text-decoration: none; cursor: pointer; white-space: nowrap;
        transition: background .2s, transform .15s;
        box-shadow: 0 4px 12px rgba(200,98,42,.28);
    }
    .btn-create:hover { background: var(--primary-dark); transform: translateY(-1px); }

    /* Flash */
    .flash-success, .flash-error {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 10px; margin-bottom: 20px;
        font-size: 14px; font-weight: 500;
    }
    .flash-success { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
    .flash-error   { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }

    /* Grid */
    .cat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 20px;
    }
    .cat-card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 16px; overflow: hidden;
        transition: transform .2s, box-shadow .2s;
    }
    .cat-card:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(26,20,16,.09); }

    .cat-img-wrap {
        position: relative; aspect-ratio: 16/9; overflow: hidden;
        background: var(--bg2);
    }
    .cat-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
    .cat-img-placeholder {
        width: 100%; height: 100%;
        display: flex; align-items: center; justify-content: center;
        color: var(--border);
    }
    .cat-count-badge {
        position: absolute; top: 10px; right: 10px;
        background: rgba(26,20,16,.6); backdrop-filter: blur(4px);
        color: white; padding: 4px 10px; border-radius: 999px;
        font-size: 11px; font-weight: 600;
    }

    .cat-body { padding: 14px 16px 10px; }
    .cat-name { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 6px; }
    .cat-meta { display: flex; align-items: center; gap: 8px; }
    .cat-icon-badge {
        font-size: 16px; background: var(--accent-light);
        padding: 2px 8px; border-radius: 6px;
    }
    .cat-date { font-size: 12px; color: var(--text-muted); }

    .cat-actions {
        display: flex; gap: 8px;
        padding: 10px 16px 14px;
    }
    .btn-edit {
        flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        background: var(--bg); border: 1px solid var(--border);
        color: var(--text); padding: 9px; border-radius: 10px;
        font-family: inherit; font-size: 13px; font-weight: 600;
        text-decoration: none; cursor: pointer;
        transition: background .2s, border-color .2s, color .2s;
    }
    .btn-edit:hover { background: var(--accent-light); border-color: var(--primary-light); color: var(--primary-dark); }
    .btn-edit svg { color: var(--primary); }

    .btn-delete {
        flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        background: #fef2f2; border: 1px solid #fecaca;
        color: #b91c1c; padding: 9px; border-radius: 10px;
        font-family: inherit; font-size: 13px; font-weight: 600;
        cursor: pointer; transition: background .2s, border-color .2s;
    }
    .btn-delete:hover { background: #fee2e2; border-color: #fca5a5; }

    /* Empty */
    .empty-state {
        text-align: center; padding: 80px 20px; color: var(--text-muted);
    }
    .empty-state svg { width: 56px; height: 56px; color: var(--border); margin-bottom: 16px; }
    .empty-state h3 { font-size: 20px; color: var(--text); margin-bottom: 8px; }

    /* Modal */
    .modal-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,.45);
        display: none; align-items: center; justify-content: center; z-index: 1000;
        backdrop-filter: blur(3px);
    }
    .modal-overlay.show { display: flex; }
    .modal {
        background: white; border-radius: 20px; padding: 36px;
        width: 100%; max-width: 400px;
        text-align: center; box-shadow: 0 24px 60px rgba(0,0,0,.2);
        animation: popIn .2s ease;
    }
    @keyframes popIn {
        from { transform: scale(.9); opacity: 0; }
        to   { transform: scale(1);  opacity: 1; }
    }
    .modal-icon {
        width: 64px; height: 64px; border-radius: 50%;
        background: #fef2f2; color: #b91c1c;
        display: grid; place-items: center; margin: 0 auto 20px;
    }
    .modal-title { font-size: 20px; font-weight: 700; color: var(--text); margin-bottom: 10px; }
    .modal-desc { font-size: 14px; color: var(--text-muted); line-height: 1.6; margin-bottom: 28px; }
    .modal-actions { display: flex; gap: 12px; }
    .btn-modal-cancel {
        flex: 1; padding: 12px; border-radius: 12px;
        border: 1.5px solid var(--border); background: white;
        font-family: inherit; font-size: 14px; font-weight: 600;
        color: var(--text); cursor: pointer; transition: background .2s;
    }
    .btn-modal-cancel:hover { background: var(--bg); }
    .btn-modal-delete {
        flex: 1; padding: 12px; border-radius: 12px;
        border: none; background: #ef4444;
        font-family: inherit; font-size: 14px; font-weight: 600;
        color: white; cursor: pointer; display: flex; align-items: center;
        justify-content: center; gap: 6px;
        transition: background .2s;
    }
    .btn-modal-delete:hover { background: #dc2626; }
</style>

<script>
    function confirmDelete(id, name) {
        document.getElementById('deleteName').textContent = name;
        document.getElementById('deleteForm').action = '/admin/categories/' + id + '/delete';
        document.getElementById('deleteModal').classList.add('show');
    }
    function closeModal() {
        document.getElementById('deleteModal').classList.remove('show');
    }
    document.getElementById('deleteModal').addEventListener('click', function(e) {
        if (e.target === this) closeModal();
    });
</script>