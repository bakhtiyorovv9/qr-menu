<div class="page-header" style="animation: fadeUp .4s ease both;">
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">Xush kelibsiz, {{adminName}}!</p>
</div>

<!-- Stats -->
<div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:20px; margin-bottom:28px; animation: fadeUp .4s .1s ease both;">

    <div style="background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); padding:24px; box-shadow:var(--shadow);">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
            <span style="font-size:13px; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:.06em;">Mahsulotlar</span>
            <div style="width:40px;height:40px;border-radius:12px;background:rgba(200,98,42,.12);display:flex;align-items:center;justify-content:center;font-size:18px;">🍽️</div>
        </div>
        <p style="font-family:'Playfair Display',serif; font-size:36px; font-weight:700; color:var(--text); margin-bottom:4px;">{{totalProducts}}</p>
        <a href="/admin/products" style="font-size:13px; color:var(--primary); text-decoration:none; font-weight:600;">Ko'rish →</a>
    </div>

    <div style="background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); padding:24px; box-shadow:var(--shadow);">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
            <span style="font-size:13px; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:.06em;">Kategoriyalar</span>
            <div style="width:40px;height:40px;border-radius:12px;background:rgba(245,166,35,.12);display:flex;align-items:center;justify-content:center;font-size:18px;">🗂️</div>
        </div>
        <p style="font-family:'Playfair Display',serif; font-size:36px; font-weight:700; color:var(--text); margin-bottom:4px;">{{totalCategories}}</p>
        <a href="/admin/categories" style="font-size:13px; color:var(--primary); text-decoration:none; font-weight:600;">Ko'rish →</a>
    </div>

    <div style="background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); padding:24px; box-shadow:var(--shadow);">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
            <span style="font-size:13px; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:.06em;">Foydalanuvchilar</span>
            <div style="width:40px;height:40px;border-radius:12px;background:rgba(58,158,110,.12);display:flex;align-items:center;justify-content:center;font-size:18px;">👥</div>
        </div>
        <p style="font-family:'Playfair Display',serif; font-size:36px; font-weight:700; color:var(--text); margin-bottom:4px;">{{totalUsers}}</p>
        <a href="/admin/users" style="font-size:13px; color:var(--primary); text-decoration:none; font-weight:600;">Ko'rish →</a>
    </div>
</div>

<!-- Quick actions -->
<div style="background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); padding:28px; box-shadow:var(--shadow); animation: fadeUp .4s .2s ease both;">
    <h3 style="font-family:'Playfair Display',serif; font-size:18px; font-weight:700; margin-bottom:20px;">Tezkor harakatlar</h3>
    <div style="display:grid; grid-template-columns: repeat(2,1fr); gap:14px;">
        <a href="/admin/categories/create" style="display:flex;align-items:center;gap:14px;padding:18px;background:var(--bg);border:1.5px solid var(--border);border-radius:14px;text-decoration:none;color:var(--text);transition:all .2s;" onmouseover="this.style.borderColor='var(--primary)';this.style.background='#fff8f5'" onmouseout="this.style.borderColor='var(--border)';this.style.background='var(--bg)'">
            <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,var(--primary),var(--primary-light));display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">🗂️</div>
            <div>
                <p style="font-size:14px;font-weight:700;margin-bottom:3px;">Kategoriya qo'shish</p>
                <p style="font-size:12px;color:var(--text-muted);">Yangi menyu bo'limi yarating</p>
            </div>
        </a>
        <a href="/admin/products/create" style="display:flex;align-items:center;gap:14px;padding:18px;background:var(--bg);border:1.5px solid var(--border);border-radius:14px;text-decoration:none;color:var(--text);transition:all .2s;" onmouseover="this.style.borderColor='var(--primary)';this.style.background='#fff8f5'" onmouseout="this.style.borderColor='var(--border)';this.style.background='var(--bg)'">
            <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#f7c948);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">🍽️</div>
            <div>
                <p style="font-size:14px;font-weight:700;margin-bottom:3px;">Mahsulot qo'shish</p>
                <p style="font-size:12px;color:var(--text-muted);">Menyuga taom yoki ichimlik qo'shing</p>
            </div>
        </a>
    </div>
</div>