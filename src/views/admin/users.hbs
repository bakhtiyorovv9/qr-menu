{{!-- src/views/admin/users.hbs --}}
<div class="page-header">
    <div>
        <h1 class="page-title">Foydalanuvchilar</h1>
        <p class="page-sub">Barcha ro'yxatdan o'tgan foydalanuvchilar ({{users.length}} ta)</p>
    </div>
    <div class="filter-tabs">
        <a href="/admin/users" class="tab {{#unless activeRole}}active{{/unless}}">
            Hammasi <span class="tab-count">{{totalCount}}</span>
        </a>
        <a href="/admin/users?role=USER" class="tab {{#if (eq activeRole 'USER')}}active{{/if}}">
            <i data-lucide="user" width="13" height="13"></i>
            Foydalanuvchilar <span class="tab-count">{{userCount}}</span>
        </a>
        <a href="/admin/users?role=ADMIN" class="tab {{#if (eq activeRole 'ADMIN')}}active{{/if}}">
            <i data-lucide="shield" width="13" height="13"></i>
            Adminlar <span class="tab-count">{{adminCount}}</span>
        </a>
    </div>
</div>

{{#if flash.success}}
    <div class="flash-success">
        <i data-lucide="check-circle" width="16" height="16"></i>
        {{flash.success}}
    </div>
{{/if}}
{{#if flash.error}}
    <div class="flash-error">
        <i data-lucide="alert-circle" width="16" height="16"></i>
        {{flash.error}}
    </div>
{{/if}}

{{#if users.length}}
    <div class="users-table-wrap">
        <table class="users-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Foydalanuvchi</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Feedbacklar</th>
                    <th>Ro'yxatdan o'tgan</th>
                    <th>Amallar</th>
                </tr>
            </thead>
            <tbody>
                {{#each users}}
                    <tr class="{{#if (eq this.role 'ADMIN')}}row-admin{{/if}}">
                        <td class="td-num">{{addOne @index}}</td>
                        <td>
                            <div class="user-cell">
                                <div class="user-avatar {{this.role}}">
                                    {{firstLetter this.name}}
                                </div>
                                <div>
                                    <div class="user-name">{{this.name}}</div>
                                </div>
                            </div>
                        </td>
                        <td class="td-email">{{this.email}}</td>
                        <td>
                            <span class="role-badge {{this.role}}">
                                {{#if (eq this.role 'ADMIN')}}
                                    <i data-lucide="shield" width="11" height="11"></i>
                                    Admin
                                {{else}}
                                    <i data-lucide="user" width="11" height="11"></i>
                                    User
                                {{/if}}
                            </span>
                        </td>
                        <td class="td-center">
                            <span class="feedback-count">{{this.feedbackCount}}</span>
                        </td>
                        <td class="td-date">{{this.createdAtFormatted}}</td>
                        <td>
                            {{#unless (eq this.role 'ADMIN')}}
                                <button class="btn-delete"
                                        onclick="confirmDelete('{{this._id}}', '{{this.name}}')">
                                    <i data-lucide="trash-2" width="13" height="13"></i>
                                    O'chirish
                                </button>
                            {{else}}
                                <span class="td-protected">
                                    <i data-lucide="lock" width="13" height="13"></i>
                                    Himoyalangan
                                </span>
                            {{/unless}}
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
{{else}}
    <div class="empty-state">
        <i data-lucide="users"></i>
        <h3>Foydalanuvchilar yo'q</h3>
        <p>Hali hech kim ro'yxatdan o'tmagan.</p>
    </div>
{{/if}}

<!-- Delete modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal">
        <div class="modal-icon">
            <i data-lucide="user-x" width="28" height="28"></i>
        </div>
        <h3 class="modal-title">Foydalanuvchini o'chirish</h3>
        <p class="modal-desc">
            "<strong id="deleteName"></strong>" foydalanuvchisini o'chirmoqchimisiz?
            Uning barcha ma'lumotlari ham o'chib ketadi.
        </p>
        <div class="modal-actions">
            <button class="btn-modal-cancel" onclick="closeModal()">Bekor qilish</button>
            <form id="deleteForm" method="POST">
                <button type="submit" class="btn-modal-delete">
                    <i data-lucide="trash-2" width="14" height="14"></i>
                    Ha, o'chirish
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .page-header {
        display: flex; align-items: flex-start; justify-content: space-between;
        margin-bottom: 28px; gap: 16px; flex-wrap: wrap;
    }
    .page-title { font-size: 26px; font-weight: 700; color: var(--text); letter-spacing: -.02em; }
    .page-sub { font-size: 14px; color: var(--text-muted); margin-top: 4px; }

    /* Tabs */
    .filter-tabs { display: flex; gap: 8px; flex-wrap: wrap; }
    .tab {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 16px; border-radius: 10px;
        font-size: 13px; font-weight: 600; text-decoration: none;
        color: var(--text-muted); background: var(--surface);
        border: 1.5px solid var(--border); transition: all .2s;
    }
    .tab:hover { border-color: var(--primary-light); color: var(--primary); }
    .tab.active { background: var(--primary); border-color: var(--primary); color: white; }
    .tab-count {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 20px; height: 20px; border-radius: 999px;
        background: rgba(255,255,255,.25); font-size: 11px; padding: 0 5px;
    }
    .tab:not(.active) .tab-count { background: var(--bg2); color: var(--text-muted); }

    /* Flash */
    .flash-success, .flash-error {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 10px; margin-bottom: 20px;
        font-size: 14px; font-weight: 500;
    }
    .flash-success { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
    .flash-error   { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }

    /* Table */
    .users-table-wrap {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 16px; overflow: hidden;
    }
    .users-table {
        width: 100%; border-collapse: collapse;
    }
    .users-table thead tr {
        background: var(--bg);
        border-bottom: 1px solid var(--border);
    }
    .users-table th {
        padding: 12px 16px; text-align: left;
        font-size: 11px; font-weight: 700; letter-spacing: .08em;
        text-transform: uppercase; color: var(--text-muted);
    }
    .users-table tbody tr {
        border-bottom: 1px solid var(--border);
        transition: background .15s;
    }
    .users-table tbody tr:last-child { border-bottom: none; }
    .users-table tbody tr:hover { background: var(--bg); }
    .users-table tbody tr.row-admin { background: rgba(200,98,42,.03); }

    .users-table td { padding: 14px 16px; vertical-align: middle; }

    .td-num { font-size: 13px; color: var(--text-muted); font-weight: 500; width: 40px; }
    .td-email { font-size: 13px; color: var(--text-muted); }
    .td-date  { font-size: 12px; color: var(--text-muted); white-space: nowrap; }
    .td-center { text-align: center; }
    .td-protected {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 12px; color: var(--text-muted); font-style: italic;
    }

    /* User cell */
    .user-cell { display: flex; align-items: center; gap: 10px; }
    .user-avatar {
        width: 36px; height: 36px; border-radius: 50%;
        display: grid; place-items: center;
        font-size: 14px; font-weight: 700; color: white; flex-shrink: 0;
    }
    .user-avatar.ADMIN { background: linear-gradient(135deg, var(--primary), var(--accent)); }
    .user-avatar.USER  { background: linear-gradient(135deg, #6366f1, #8b5cf6); }
    .user-name { font-size: 14px; font-weight: 600; color: var(--text); }

    /* Role badge */
    .role-badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 10px; border-radius: 999px;
        font-size: 11px; font-weight: 700;
    }
    .role-badge.ADMIN { background: var(--accent-light); color: var(--primary-dark); border: 1px solid rgba(245,166,35,.3); }
    .role-badge.USER  { background: #ede9fe; color: #5b21b6; border: 1px solid #ddd6fe; }

    /* Feedback count */
    .feedback-count {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 24px; height: 24px; border-radius: 999px;
        background: var(--bg2); color: var(--text-muted);
        font-size: 12px; font-weight: 700; padding: 0 8px;
    }

    /* Delete btn */
    .btn-delete {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 6px 14px; border-radius: 8px;
        background: #fef2f2; border: 1px solid #fecaca;
        color: #b91c1c; font-family: inherit;
        font-size: 12px; font-weight: 600; cursor: pointer;
        transition: background .2s;
    }
    .btn-delete:hover { background: #fee2e2; }

    /* Empty */
    .empty-state {
        text-align: center; padding: 80px 20px; color: var(--text-muted);
    }
    .empty-state svg { width: 56px; height: 56px; color: var(--border); margin-bottom: 16px; }
    .empty-state h3 { font-size: 20px; color: var(--text); margin-bottom: 8px; }

    /* Modal */
    .modal-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,.45);
        display: none; align-items: center; justify-content: center; z-index: 1000;
        backdrop-filter: blur(3px);
    }
    .modal-overlay.show { display: flex; }
    .modal {
        background: white; border-radius: 20px; padding: 36px;
        width: 100%; max-width: 400px;
        text-align: center; box-shadow: 0 24px 60px rgba(0,0,0,.2);
        animation: popIn .2s ease;
    }
    @keyframes popIn {
        from { transform: scale(.9); opacity: 0; }
        to   { transform: scale(1); opacity: 1; }
    }
    .modal-icon {
        width: 64px; height: 64px; border-radius: 50%;
        background: #fef2f2; color: #b91c1c;
        display: grid; place-items: center; margin: 0 auto 20px;
    }
    .modal-title { font-size: 20px; font-weight: 700; color: var(--text); margin-bottom: 10px; }
    .modal-desc { font-size: 14px; color: var(--text-muted); line-height: 1.6; margin-bottom: 28px; }
    .modal-actions { display: flex; gap: 12px; }
    .btn-modal-cancel {
        flex: 1; padding: 12px; border-radius: 12px;
        border: 1.5px solid var(--border); background: white;
        font-family: inherit; font-size: 14px; font-weight: 600;
        color: var(--text); cursor: pointer; transition: background .2s;
    }
    .btn-modal-cancel:hover { background: var(--bg); }
    .btn-modal-delete {
        flex: 1; padding: 12px; border-radius: 12px;
        border: none; background: #ef4444;
        font-family: inherit; font-size: 14px; font-weight: 600;
        color: white; cursor: pointer;
        display: flex; align-items: center; justify-content: center; gap: 6px;
        transition: background .2s;
    }
    .btn-modal-delete:hover { background: #dc2626; }

    @media (max-width: 768px) {
        .users-table-wrap { overflow-x: auto; }
        .users-table { min-width: 640px; }
    }
</style>

<script>
    function confirmDelete(id, name) {
        document.getElementById('deleteName').textContent = name;
        document.getElementById('deleteForm').action = '/admin/users/' + id + '/delete';
        document.getElementById('deleteModal').classList.add('show');
    }
    function closeModal() {
        document.getElementById('deleteModal').classList.remove('show');
    }
    document.getElementById('deleteModal').addEventListener('click', function(e) {
        if (e.target === this) closeModal();
    });
</script>