    <script>
        lucide.createIcons();

        // Tip tanlash
        document.querySelectorAll('.tip-card').forEach(function(card) {
            card.addEventListener('click', function() {
                document.querySelectorAll('.tip-card').forEach(function(c) {
                    c.classList.remove('selected');
                });
                card.classList.add('selected');
            });
        });

        // Star rating
        (function() {
            var stars = document.querySelectorAll('.star-rating input');
            var ratingValue = document.getElementById('ratingValue');
            stars.forEach(function(s) {
                s.addEventListener('change', function() {
                    ratingValue.textContent = s.value + ' yulduz';
                });
            });
        })();

        // Char counter
        var msg = document.getElementById('messageArea');
        var cnt = document.getElementById('charCount');
        msg.addEventListener('input', function() {
            cnt.textContent = msg.value.length + '/1000';
        });

        // Rasm preview
        document.getElementById('imageInput').addEventListener('change', function() {
            var preview = document.getElementById('uploadPreview');
            preview.innerHTML = '';
            if (this.files && this.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var img = document.createElement('img');
                    img.src = e.target.result;
                    preview.appendChild(img);
                    preview.style.display = 'flex';
                };
                reader.readAsDataURL(this.files[0]);
            }
        });

        // device_info — browser dan avtomatik olish
        (function() {
            var ua = navigator.userAgent;
            var platform = navigator.platform || 'Noma\'lum';
            var now = new Date().toISOString().split('T')[0];

            var deviceType = /Mobi|Android/i.test(ua) ? 'Mobile' : 'Desktop';
            var browser = 'Noma\'lum';
            if (/Firefox/.test(ua))      browser = 'Firefox';
            else if (/Edg/.test(ua))     browser = 'Edge';
            else if (/Chrome/.test(ua))  browser = 'Chrome';
            else if (/Safari/.test(ua))  browser = 'Safari';

            var info = deviceType + ' - ' + browser + ' - ' + platform + ' - ' + now;

            document.getElementById('deviceInfoInput').value = info;
            document.getElementById('deviceMeta').innerHTML =
                '<strong>' + deviceType + ' qurilma</strong> - ' + browser + ' - ' + now;
        })();

        // Submit loading
        document.getElementById('feedbackForm').addEventListener('submit', function() {
            var btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.textContent = 'Yuborilmoqda...';
        });
    // User dropdown
    (function () {
        var btn = document.getElementById("userBtn");
        var dropdown = document.getElementById("userDropdown");
        if (!btn || !dropdown) return;
        btn.addEventListener("click", function (e) {
            e.stopPropagation();
            dropdown.classList.toggle("show");
        });
        document.addEventListener("click", function (e) {
            if (!dropdown.contains(e.target) && !btn.contains(e.target)) {
                dropdown.classList.remove("show");
            }
        });
    })();
    
    </script>
