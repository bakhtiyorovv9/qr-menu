<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} | MossMenu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --primary: #c8622a;
            --primary-dark: #a34d1e;
            --primary-light: #e8845a;
            --accent: #f5a623;
            --bg: #f7f3ef;
            --surface: #ffffff;
            --text: #1a1410;
            --text-muted: #7a6a5a;
            --border: #e2d8cc;
            --error: #d94f4f;
            --success: #3a9e6e;
            --shadow: 0 8px 40px rgba(100, 50, 20, 0.12);
            --shadow-lg: 0 20px 60px rgba(100, 50, 20, 0.18);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px;
            color: var(--text);
        }

        .auth-wrapper {
            width: 100%;
            max-width: 1000px;
            background: var(--surface);
            border-radius: 28px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            display: grid;
            grid-template-columns: 1fr 1fr;
            min-height: 620px;
            animation: fadeUp 0.5s ease both;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ---- LEFT PANEL ---- */
        .auth-panel {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 44px 40px;
            overflow: hidden;
            background: #1a0e08;
        }

        .auth-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=700&q=80') center/cover no-repeat;
            opacity: 0.45;
            transition: transform 8s ease;
        }

        .auth-panel:hover::before {
            transform: scale(1.04);
        }

        .auth-panel::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                160deg,
                rgba(200, 98, 42, 0.3) 0%,
                rgba(26, 14, 8, 0.85) 70%
            );
        }

        .panel-logo {
            position: absolute;
            top: 36px;
            left: 40px;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .panel-logo .logo-icon {
            width: 38px;
            height: 38px;
            background: var(--primary);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .panel-logo .logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 18px;
            font-weight: 700;
            color: #fff;
            letter-spacing: 0.02em;
        }

        .panel-content {
            position: relative;
            z-index: 2;
        }

        .panel-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(245, 166, 35, 0.2);
            border: 1px solid rgba(245, 166, 35, 0.4);
            color: var(--accent);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 6px 14px;
            border-radius: 20px;
            margin-bottom: 20px;
        }

        .panel-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #fff;
            line-height: 1.2;
            margin-bottom: 14px;
        }

        .panel-desc {
            font-size: 15px;
            color: rgba(255,255,255,0.72);
            line-height: 1.65;
            max-width: 300px;
            margin-bottom: 28px;
        }

        .panel-divider {
            height: 1px;
            background: rgba(255,255,255,0.15);
            margin-bottom: 20px;
        }

        .panel-security {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: rgba(255,255,255,0.55);
        }

        .panel-security svg {
            flex-shrink: 0;
            color: var(--accent);
        }

        /* ---- RIGHT PANEL ---- */
        .auth-form-side {
            padding: 48px 48px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: #fff;
        }

        .auth-tabs {
            display: flex;
            background: #f2ede8;
            border-radius: 14px;
            padding: 4px;
            margin-bottom: 36px;
            width: fit-content;
        }

        .auth-tab {
            padding: 9px 26px;
            border-radius: 11px;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            color: var(--text-muted);
            transition: all 0.2s;
        }

        .auth-tab.active {
            background: #fff;
            color: var(--text);
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(0,0,0,0.09);
        }

        .auth-tab:hover:not(.active) {
            color: var(--text);
        }

        .form-title {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 6px;
        }

        .form-subtitle {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 28px;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 7px;
        }

        label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text);
            letter-spacing: 0.01em;
        }

        .forgot-link {
            font-size: 13px;
            font-weight: 500;
            color: var(--primary);
            text-decoration: none;
            transition: color 0.15s;
        }

        .forgot-link:hover { color: var(--primary-dark); }

        .input-wrap {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #b0a090;
            pointer-events: none;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 12px 44px 12px 42px;
            border: 1.5px solid var(--border);
            border-radius: 12px;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            color: var(--text);
            background: #faf8f6;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }

        input:focus {
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(200, 98, 42, 0.1);
        }

        input::placeholder { color: #c4b8ac; }

        .toggle-pw {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #b0a090;
            padding: 4px;
            display: flex;
            align-items: center;
            transition: color 0.15s;
        }
        .toggle-pw:hover { color: var(--text-muted); }

        .remember-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 22px;
        }

        .custom-check {
            position: relative;
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        .custom-check input {
            position: absolute;
            opacity: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
        }

        .check-box {
            width: 18px;
            height: 18px;
            border: 1.5px solid var(--border);
            border-radius: 5px;
            background: #faf8f6;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s;
        }

        .custom-check input:checked + .check-box {
            background: var(--primary);
            border-color: var(--primary);
        }

        .custom-check input:checked + .check-box::after {
            content: '';
            width: 5px;
            height: 9px;
            border: 2px solid white;
            border-top: none;
            border-left: none;
            transform: rotate(45deg) translateY(-1px);
            display: block;
        }

        .remember-label {
            font-size: 13px;
            color: var(--text-muted);
            cursor: pointer;
            user-select: none;
        }

        .btn-primary {
            width: 100%;
            padding: 14px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 12px;
            font-family: 'DM Sans', sans-serif;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            letter-spacing: 0.02em;
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
            box-shadow: 0 4px 16px rgba(200, 98, 42, 0.3);
            margin-bottom: 22px;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(200, 98, 42, 0.38);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        .divider span {
            font-size: 12px;
            font-weight: 600;
            color: #b5a898;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .social-btns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 28px;
        }

        .btn-social {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 16px;
            border: 1.5px solid var(--border);
            border-radius: 12px;
            background: #faf8f6;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            font-weight: 500;
            color: var(--text);
            cursor: pointer;
            text-decoration: none;
            transition: border-color 0.2s, background 0.2s, transform 0.15s;
        }

        .btn-social:hover {
            border-color: var(--primary-light);
            background: #fff;
            transform: translateY(-1px);
        }

        .back-link {
            text-align: center;
            font-size: 13px;
            color: var(--text-muted);
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: color 0.15s;
        }

        .back-link:hover { color: var(--text); }

        .alert {
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 13px;
            margin-bottom: 18px;
            font-weight: 500;
        }

        .alert-error {
            background: #fdf0f0;
            border: 1px solid #f5c6c6;
            color: var(--error);
        }

        .alert-success {
            background: #f0faf4;
            border: 1px solid #b6e4cc;
            color: var(--success);
        }

        .footer-text {
            text-align: center;
            font-size: 13px;
            color: #b5a898;
            margin-top: 20px;
        }

        @media (max-width: 720px) {
            .auth-wrapper {
                grid-template-columns: 1fr;
                max-width: 480px;
            }
            .auth-panel { display: none; }
            .auth-form-side { padding: 36px 28px; }
        }
    </style>
</head>
<body>
    {{{body}}}

    <p class="footer-text">© 2024 MossMenu. Barcha huquqlar himoyalangan.</p>

    <script>
        // Password toggle
        document.querySelectorAll('.toggle-pw').forEach(btn => {
            btn.addEventListener('click', () => {
                const input = btn.closest('.input-wrap').querySelector('input');
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                btn.querySelector('.eye-open').style.display = isPassword ? 'none' : 'block';
                btn.querySelector('.eye-closed').style.display = isPassword ? 'block' : 'none';
            });
        });
    </script>
</body>
</html>
