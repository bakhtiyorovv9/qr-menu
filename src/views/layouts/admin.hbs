</aside>

<!-- ══ MAIN AREA ══ -->
<div class="main-wrap">
    <!-- Topbar -->
    <header class="topbar">
        <div class="topbar-left">
            <div class="breadcrumb">
                <a href="/admin">Admin</a>
                <span class="sep">›</span>
                <span class="current">{{title}}</span>
            </div>
        </div>
        <div class="topbar-right">
            <div class="stat-pill">
                <span class="stat-dot"></span>
                Tizim ishlayapti
            </div>
            <div class="topbar-avatar">{{adminInitial}}</div>
        </div>
    </header>

    <!-- Page content injected here -->
    <main class="page-content">
        {{{body}}}
    </main>
</div>

<script>
    // Drag & drop upload zones
    document.querySelectorAll('.upload-zone').forEach(zone => {
        zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
        zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
        zone.addEventListener('drop', e => {
            e.preventDefault();
            zone.classList.remove('drag-over');
            const file = e.dataTransfer.files[0];
            if (file) handleFile(zone, file);
        });
        const input = zone.querySelector('input[type="file"]');
        if (input) {
            input.addEventListener('change', () => {
                if (input.files[0]) handleFile(zone, input.files[0]);
            });
        }
    });

    function handleFile(zone, file) {
        if (!file.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = e => {
            const preview = zone.closest('.form-group').querySelector('.img-preview');
            if (preview) {
                preview.querySelector('img').src = e.target.result;
                preview.style.display = 'block';
            }
        };
        reader.readAsDataURL(file);
    }

    // Image preview remove
    document.querySelectorAll('.img-preview-remove').forEach(btn => {
        btn.addEventListener('click', () => {
            const preview = btn.closest('.img-preview');
            preview.style.display = 'none';
            const input = preview.closest('.form-group').querySelector('input[type="file"]');
            if (input) input.value = '';
        });
    });

    // Star rating
    document.querySelectorAll('.stars-input').forEach(starsWrap => {
        const stars = starsWrap.querySelectorAll('.star-btn');
        const hiddenInput = starsWrap.querySelector('input[type="hidden"]');
        const valueLabel = starsWrap.querySelector('.rating-value');
        let current = parseInt(hiddenInput?.value || 0);

        function renderStars(val) {
            stars.forEach((s, i) => s.classList.toggle('active', i < val));
            if (valueLabel) valueLabel.textContent = val > 0 ? `${val} / 5` : 'Tanlang';
        }

        renderStars(current);

        stars.forEach((star, i) => {
            star.addEventListener('mouseenter', () => renderStars(i + 1));
            star.addEventListener('mouseleave', () => renderStars(current));
            star.addEventListener('click', () => {
                current = i + 1;
                if (hiddenInput) hiddenInput.value = current;
                renderStars(current);
            });
        });
    });
</script>
</body>
</html>
